{
  "admin_origins": [
    "http://127.0.0.1:5173",
    "http://localhost:5173",
    "https://app.gradstep.ai",
    "https://admin.gradstep.ai"
  ],
  "support_bucket": {
    "id": "support",
    "name": "support",
    "public": false,
    "file_size_limit": 5242880,
    "allowed_mime_types": [
      "image/png",
      "image/jpeg"
    ]
  },
  "database": {
    "ssl_enforced": true,
    "client_ssl_mode": "verify-full",
    "ca_file": "infra/supabase-ca-2021.crt",
    "session_pooler_host": "aws-0-us-west-2.pooler.supabase.com",
    "session_pooler_port": 5432
  },
  "paper_bucket": {
    "id": "paper-assets",
    "name": "paper-assets",
    "public": false,
    "file_size_limit": 67108864,
    "allowed_mime_types": null
  },
  "podcast_bucket": {
    "id": "podcast-assets",
    "name": "podcast-assets",
    "public": false,
    "file_size_limit": 16777216,
    "allowed_mime_types": [
      "audio/mp4",
      "application/json"
    ]
  },
  "podcast_source_bucket": {
    "id": "private-content",
    "name": "private-content",
    "public": false,
    "file_size_limit": 524288,
    "allowed_mime_types": [
      "text/plain"
    ]
  },
  "upload_bucket": {
    "id": "paper-uploads",
    "name": "paper-uploads",
    "public": false,
    "file_size_limit": 4194304,
    "allowed_mime_types": [
      "application/octet-stream"
    ]
  },
  "functions": [
    "support-assets",
    "reader-artifact",
    "reader-member",
    "chat",
    "discover",
    "account-delete",
    "store-sync",
    "app-store-notifications",
    "add-reference",
    "admin-accounts",
    "admin-spending",
    "add-paper",
    "upload-pdf",
    "podcast",
    "podcast-member"
  ],
  "pipeline_schedule": "* * * * *",
  "chat_web_search": true,
  "chat_deepseek": "on",
  "chat_gemini": "hidden",
  "app_store": {
    "bundle_id": "com.sciencereader.ios",
    "environments": [
      "Sandbox"
    ],
    "online_checks": true
  },
  "pipeline_worker_url": "https://gradstep-pipeline-885355087025.us-west1.run.app",
  "podcast_speech": {
    "service_account": "gradstep-podcast-speech@gradstep.iam.gserviceaccount.com",
    "project": "gradstep"
  },
  "fault_injection": true
}
