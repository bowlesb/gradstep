-- Disabled local-only candidate. Original execution policies in this version
-- describe LOOPBACK FIXTURES, never hosted Storage or measured host admission.
-- Applied 001--011 and pending 012 bytes remain unchanged. No login is created.
begin;

-- Drain the established authority -> policy order before any FK/DDL barrier.
lock table app_private.executor_authority in access exclusive mode;
lock table app_private.acquisition_policy, app_private.paper_storage_capacity,
 app_private.arxiv_network_gate, app_private.acquisition_jobs,
 app_private.acquisition_steps, app_private.paper_asset_reservations,
 app_private.execution_attempts, app_private.execution_quiescence in access exclusive mode;
do $$ begin
 if exists(select 1 from app_private.executor_authority where enabled)
 or exists(select 1 from app_private.acquisition_policy where metadata_enabled or original_enabled or verification_enabled)
 or exists(select 1 from app_private.paper_read_policy where enabled) then
  raise exception 'original_migration_requires_disabled_workers';
 end if;
end $$;

alter table app_private.acquisition_jobs
 drop constraint acquisition_jobs_execution_contract_check,
 drop constraint acquisition_jobs_stage_check,
 drop constraint acquisition_jobs_slots_held_check,
 add constraint acquisition_jobs_execution_contract_check check(execution_contract in ('legacy-011','metadata-v2','original-v1')),
 add constraint acquisition_jobs_stage_check check(stage in ('atom','license','reserve','download','upload','readback','pending_verification','publish','complete')),
 add constraint acquisition_jobs_slots_held_check check(slots_held between 1 and 28),
 add constraint original_execution_envelope check((execution_contract='original-v1' and kind='original' and slots_held=28)
  or (execution_contract<>'original-v1' and slots_held<=24)),
 add column original_policy_id uuid references app_private.executor_policies(id),
 add column original_deployment_id text,
 add column original_host_id uuid,
 add column original_boot_id uuid,
 add constraint original_job_policy_pin check(((original_policy_id is null and original_deployment_id is null and original_host_id is null and original_boot_id is null)
  or (execution_contract='original-v1' and original_policy_id is not null and original_deployment_id ~ '^[A-Za-z0-9_.:-]{1,128}$'
   and original_host_id is not null and original_boot_id is not null)) is true);
create or replace function app_private.protect_execution_job_contract() returns trigger language plpgsql set search_path='' as $$
begin
 if new.execution_contract is distinct from old.execution_contract then raise exception 'immutable_execution_contract'; end if;
 if old.original_policy_id is not null and (new.original_policy_id,new.original_deployment_id,new.original_host_id,new.original_boot_id)
  is distinct from (old.original_policy_id,old.original_deployment_id,old.original_host_id,old.original_boot_id)
 then raise exception 'immutable_original_policy_pin'; end if;
 return new;
end $$;
alter table app_private.executor_policies drop constraint executor_policies_kind_check,
 add constraint executor_policies_kind_check check(kind in ('metadata-owned-child-v1','metadata-linux-scope-v1','original-loopback-scope-v1'));
alter table app_private.executor_authority
 add column original_policy_id uuid references app_private.executor_policies(id),
 add column original_deployment_id text check(original_deployment_id ~ '^[A-Za-z0-9_.:-]{1,128}$'),
 add column original_admitted boolean not null default false,
 add constraint original_authority_pin check((original_policy_id is null)=(original_deployment_id is null)),
 add constraint original_authority_enabled check(not original_admitted or
  (enabled and not recovery_required and original_policy_id is not null and admitted_host_id is not null and admitted_boot_id is not null));
-- 012 has three multi-column unnamed checks in declaration order: binding
-- digest (check), binding version/scope (check1), deadlines (check2). Preserve
-- and explicitly name the digest invariant; replace only the version check.
alter table app_private.execution_attempts rename constraint execution_attempts_check to execution_binding_digest_check;
alter table app_private.execution_attempts
 drop constraint execution_attempts_kind_check,
 drop constraint execution_attempts_byte_ceiling_check,
 drop constraint execution_attempts_check1,
 alter column charge_period drop not null,
 add column reservation_id uuid references app_private.paper_asset_reservations(id),
 add column predecessor_operation_id uuid,
 add column predecessor_result_sha256 bytea check(predecessor_result_sha256 is null or octet_length(predecessor_result_sha256)=32),
 add column original_request jsonb check(original_request is null or (jsonb_typeof(original_request)='object' and octet_length(original_request::text)<=2048)),
 add column original_request_sha256 bytea check(original_request_sha256 is null or original_request_sha256=sha256(convert_to(original_request::text,'UTF8'))),
 add column candidate_sha256 bytea check(candidate_sha256 is null or octet_length(candidate_sha256)=32),
 add column candidate_bytes bigint check(candidate_bytes between 1 and 5242880),
 add column input_spool_sha256 bytea check(input_spool_sha256 is null or octet_length(input_spool_sha256)=32),
 add column verification_generation bigint check(verification_generation>0),
 add column charge_kind text check(charge_kind in ('source_bytes','object_upload_bytes','worker_bytes')),
 add column request_day date,
 add foreign key(job_id,predecessor_operation_id) references app_private.acquisition_steps(job_id,operation_id),
 add constraint execution_attempts_kind_check check(kind in ('atom','license','original_download','original_upload','original_readback','original_verify')),
 add constraint execution_kind_binding check(((kind in ('atom','license') and
   ((binding->'version'='1'::jsonb and scope_id is null and not (binding ? 'scope'))
    or (binding->'version'='2'::jsonb and scope_id=operation_id and binding#>'{scope,scope_id}'=to_jsonb(scope_id::text))))
  or (kind like 'original_%' and binding->'version'='3'::jsonb and scope_id=operation_id
   and binding#>'{scope,scope_id}'=to_jsonb(scope_id::text))) is true),
 add constraint execution_original_columns check(((kind in ('atom','license') and byte_ceiling=1048576 and charge_period is not null
   and reservation_id is null and predecessor_operation_id is null and predecessor_result_sha256 is null
   and original_request is null and original_request_sha256 is null and candidate_sha256 is null and candidate_bytes is null
   and input_spool_sha256 is null and verification_generation is null and charge_kind is null and request_day is null)
  or (kind like 'original_%' and reservation_id is not null and predecessor_operation_id is not null and predecessor_result_sha256 is not null
   and original_request is not null and original_request_sha256 is not null and byte_ceiling between 1 and 5242880
   and ((kind='original_download' and candidate_sha256 is null and candidate_bytes is null and input_spool_sha256 is null
      and charge_kind='source_bytes' and charge_period is not null and request_day is not null and verification_generation is null)
    or (kind='original_upload' and candidate_sha256 is not null and candidate_bytes=byte_ceiling and input_spool_sha256 is not null
      and charge_kind='object_upload_bytes' and charge_period is not null and request_day is null and verification_generation is null)
    or (kind='original_readback' and candidate_sha256 is not null and candidate_bytes is not null and input_spool_sha256 is null
      and charge_kind='worker_bytes' and charge_period is not null and request_day is null and verification_generation is null)
    or (kind='original_verify' and candidate_sha256 is not null and candidate_bytes=byte_ceiling and input_spool_sha256 is not null
      and charge_kind is null and charge_period is null and request_day is null and verification_generation is not null)))) is true);
alter table app_private.execution_quiescence
 drop constraint execution_quiescence_resource_check,
 drop constraint execution_quiescence_evidence_kind_check,
 add constraint execution_quiescence_resource_check check(resource in ('executor','arxiv_connection','object_write','object_read')),
 add constraint execution_quiescence_evidence_kind_check check(evidence_kind in
  ('owned_child_joined','owned_scope_retired_v1','original_transfer_complete_v1','storage_upload_ack_v1'));
alter table app_private.acquisition_transfer_windows drop constraint acquisition_transfer_windows_kind_check,
 add constraint acquisition_transfer_windows_kind_check check(kind in ('source_requests','source_bytes','worker_bytes','reader_bytes','object_upload_bytes'));

do $$ declare n text; begin
 n:='science_reader_original_executor';
 if not exists(select 1 from pg_roles where rolname=n) then
  create role science_reader_original_executor nologin noinherit nosuperuser nocreatedb nocreaterole noreplication nobypassrls;
 elsif exists(select 1 from pg_roles where rolname=n and (rolcanlogin or rolsuper or rolcreatedb or rolcreaterole or rolreplication or rolbypassrls or rolinherit))
 then raise exception 'original_role_configuration_conflict'; end if;
 -- Preserve the existing 011 verifier role's INHERIT attribute; no privilege or
 -- membership change is implied. Actual login capabilities are separately bound.
 foreach n in array array['science_reader_original_executor','science_reader_pdf_verifier'] loop
  if exists(select 1 from pg_roles where rolname=n and (rolcanlogin or rolsuper or rolcreatedb or rolcreaterole or rolreplication or rolbypassrls))
  or exists(select 1 from pg_auth_members m join pg_roles r on r.oid=m.roleid where r.rolname=n
   and not (m.member=(select datdba from pg_database where datname=current_database())
    and m.member=(select oid from pg_roles where rolname=current_user) and m.admin_option and not m.inherit_option and not m.set_option))
  or exists(select 1 from pg_auth_members m join pg_roles r on r.oid=m.member where r.rolname=n)
  then raise exception 'original_role_membership_requires_review'; end if;
  execute format('grant usage on schema public to %I',n);
 end loop;
end $$;

create function app_private.execution_resources(p_kind text) returns text[] language plpgsql immutable set search_path='' as $$
begin
 case p_kind
  when 'atom','license','original_download' then return array['executor','arxiv_connection'];
  when 'original_upload' then return array['executor','object_write'];
  when 'original_readback' then return array['executor','object_read'];
  when 'original_verify' then return array['executor'];
  else raise exception 'invalid_execution_kind';
 end case;
end $$;
create or replace function app_private.execution_pending(p_id uuid,p_resource text) returns boolean language plpgsql stable security definer set search_path='' as $$
declare k text;
begin
 if p_resource is null or p_resource not in ('executor','arxiv_connection','object_write','object_read') then raise exception 'invalid_execution_resource'; end if;
 select kind into k from app_private.execution_attempts where id=p_id;
 if not found then raise exception 'execution_unavailable'; end if;
 return p_resource=any(app_private.execution_resources(k)) and not exists
  (select 1 from app_private.execution_quiescence where attempt_id=p_id and resource=p_resource);
end $$;
create function app_private.execution_unsettled(p_id uuid) returns boolean language plpgsql stable security definer set search_path='' as $$
declare k text;
begin
 select kind into k from app_private.execution_attempts where id=p_id;
 if not found then raise exception 'execution_unavailable'; end if;
 return exists(select 1 from unnest(app_private.execution_resources(k)) resource where app_private.execution_pending(p_id,resource));
end $$;
create or replace function app_private.legacy_execution_unsettled() returns boolean language sql stable security definer set search_path='' as $$
 select exists(select 1 from app_private.acquisition_steps s join app_private.acquisition_jobs j on j.id=s.job_id
   where j.execution_contract='legacy-011' and s.network_token is not null)
 or exists(select 1 from app_private.arxiv_network_gate g left join app_private.execution_attempts e on e.id=g.token
   where g.token is not null and e.id is null)
 or exists(select 1 from app_private.paper_asset_reservations r join app_private.acquisition_jobs j on j.id=r.job_id where j.execution_contract<>'original-v1')
 or exists(select 1 from app_private.paper_read_grants)
$$;
create or replace function app_private.execution_entry(p_id uuid) returns jsonb language sql stable security definer set search_path='' as $$
 select jsonb_build_object('id',e.id,'job_id',e.job_id,'claim_id',e.operation_id,'generation',e.generation,'kind',e.kind,
  'epoch',e.epoch,'policy_id',e.policy_id,'binding',e.binding,'binding_sha256',encode(e.binding_sha256,'hex'),
  'created_at',e.created_at,'useful_deadline',e.useful_deadline,'report_deadline',e.report_deadline,'byte_ceiling',e.byte_ceiling,
  'pending_resources',(select coalesce(jsonb_agg(r order by r),'[]'::jsonb) from unnest(app_private.execution_resources(e.kind)) r where app_private.execution_pending(e.id,r)),
  'receipts',(select coalesce(jsonb_agg(jsonb_build_object('resource',q.resource,'receipt_id',q.receipt_id,'evidence_kind',q.evidence_kind,'facts',q.facts,'accepted_at',q.accepted_at) order by q.resource),'[]'::jsonb)
   from app_private.execution_quiescence q where q.attempt_id=e.id))
  ||case when e.reservation_id is null then '{}'::jsonb else jsonb_build_object('reservation_id',e.reservation_id,
   'predecessor_operation_id',e.predecessor_operation_id,'predecessor_result_sha256',encode(e.predecessor_result_sha256,'hex'),
   'request',e.original_request,'request_sha256',encode(e.original_request_sha256,'hex'),
   'candidate_sha256',encode(e.candidate_sha256,'hex'),'candidate_bytes',e.candidate_bytes,
   'input_spool_sha256',encode(e.input_spool_sha256,'hex'),'verification_generation',e.verification_generation,
   'charge_kind',e.charge_kind,'charge_period',e.charge_period,'request_day',e.request_day,'local_fixture_only',true) end
 from app_private.execution_attempts e where e.id=p_id
$$;

create function app_private.original_shape(d jsonb,k text[],cap integer default 8192) returns void language plpgsql immutable set search_path='' as $$
begin
 if d is null or jsonb_typeof(d)<>'object' or octet_length(d::text)>cap
  or (select count(*) from jsonb_object_keys(d))<>cardinality(k) or (d-k)<>'{}'::jsonb
 then raise exception 'invalid_original_record'; end if;
end $$;
create function app_private.original_hash(d jsonb) returns bytea language plpgsql immutable set search_path='' as $$
begin
 if jsonb_typeof(d) is distinct from 'string' or d#>>'{}'!~'^[0-9a-f]{64}$' then raise exception 'invalid_original_hash'; end if;
 return decode(d#>>'{}','hex');
end $$;
create function app_private.original_uuid(d jsonb) returns uuid language plpgsql immutable set search_path='' as $$
begin
 if jsonb_typeof(d) is distinct from 'string' or d#>>'{}'!~'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' then raise exception 'invalid_original_uuid'; end if;
 return (d#>>'{}')::uuid;
end $$;
create function app_private.original_integer(d jsonb,lo bigint,hi bigint) returns bigint language plpgsql immutable set search_path='' as $$
declare n numeric;
begin
 if jsonb_typeof(d) is distinct from 'number' or d#>>'{}'!~'^(0|[1-9][0-9]{0,19})$' then raise exception 'invalid_original_integer'; end if;
 n:=(d#>>'{}')::numeric;
 if n<lo or n>hi then raise exception 'invalid_original_integer'; end if;
 return n::bigint;
end $$;
-- Used only after closed scalar/two-level spool validation. C-order matches
-- Python's ASCII key sort; the descriptor hash includes its final LF.
create function app_private.original_compact_json(d jsonb) returns text language plpgsql immutable set search_path='' as $$
declare s text;
begin
 if jsonb_typeof(d)='object' then
  select '{'||coalesce(string_agg(to_jsonb(key)::text||':'||app_private.original_compact_json(value),',' order by key collate "C"),'')||'}' into s from jsonb_each(d);
  return s;
 end if;
 if jsonb_typeof(d) not in ('string','number','boolean','null') then raise exception 'invalid_original_record'; end if;
 return d::text;
end $$;

-- Every original control record occupies one prepaid 8 KiB unit. Profiles
-- occupy two units; the eight policies and singleton fit the fixed 32 units.
create function app_private.original_record_bound() returns trigger language plpgsql set search_path='' as $$
begin
 if octet_length(to_jsonb(new)::text)>8192 then raise exception 'original_control_record_limit'; end if;
 return new;
end $$;
create trigger original_attempt_record_bound before insert on app_private.execution_attempts
 for each row when(new.reservation_id is not null) execute function app_private.original_record_bound();
create trigger original_job_record_bound before insert or update on app_private.acquisition_jobs
 for each row when(new.execution_contract='original-v1') execute function app_private.original_record_bound();

-- This profile deliberately describes a synthetic local SQL fixture. Its
-- measured-shaped numbers are NOT evidence of a real host or cgroup limit.
create function public.worker_install_original_verification_profile_v1(p_id uuid,p_canonical_profile text) returns jsonb
language plpgsql security definer set search_path='' as $$
declare d jsonb; digest bytea; old app_private.paper_verification_profiles; k text;
begin
 perform app_private.require_executor_role('science_reader_executor_admitter');
 if p_id is null or p_canonical_profile is null or octet_length(p_canonical_profile)>4096 then raise exception 'invalid_original_profile'; end if;
 d:=p_canonical_profile::jsonb; digest:=sha256(convert_to(p_canonical_profile,'UTF8'));
 perform app_private.original_shape(d,array['version','kind','local_fixture_only','evidence_scope','parser_profile_sha256','build_sha256',
  'max_bytes','max_pages','wasm_memory_bytes','host_memory_bytes','cpu_ms','wall_ms','measurement','host_policy_sha256'],4096);
 if d->'version' is distinct from '1'::jsonb or d->>'kind' is distinct from 'original-loopback-verifier-v1'
  or d->'local_fixture_only' is distinct from 'true'::jsonb or d->>'evidence_scope' is distinct from 'synthetic-sql-fixture'
  or d->>'measurement' is distinct from 'owned-process-rss-upper-envelope-v1'
  or d->>'parser_profile_sha256' is distinct from 'c8478d6e1b1f7a8631132789a471a7f525123f40d2e893890254fb1660b54962'
  or d->>'build_sha256' is distinct from '39980de20b9cd8717d10318e8f0c0a8869bf184c1292fe31987fe34c6e707610'
  then raise exception 'invalid_original_profile'; end if;
 perform app_private.original_hash(d->'host_policy_sha256');
 if app_private.original_integer(d->'max_bytes',1,5242880)<>5242880
  or app_private.original_integer(d->'max_pages',1,50)<>50
  or app_private.original_integer(d->'wasm_memory_bytes',1,67108864)<>67108864
  or app_private.original_integer(d->'host_memory_bytes',1,268435456)<>268435456
  or app_private.original_integer(d->'cpu_ms',1,2000)<>2000
  or app_private.original_integer(d->'wall_ms',1,5000)<>5000 then raise exception 'invalid_original_profile'; end if;
 perform 1 from app_private.executor_authority where singleton for update;
 perform 1 from app_private.acquisition_policy where singleton for update;
 select * into old from app_private.paper_verification_profiles where id=p_id;
 if found then
  if old.profile_sha256<>digest then raise exception 'operation_id_conflict'; end if;
  return jsonb_build_object('id',p_id,'sha256',encode(digest,'hex'),'replayed',true,'local_fixture_only',true);
 end if;
 insert into app_private.paper_verification_profiles(id,profile_sha256,definition,canonical_profile,build_sha256,max_bytes,max_pages,
  wasm_memory_bytes,host_memory_bytes,cpu_ms,wall_ms,resource_evidence,verifier_identity)
 values(p_id,digest,d,p_canonical_profile,decode(d->>'build_sha256','hex'),5242880,50,67108864,268435456,2000,5000,
  'measured','original-loopback-verifier-v1:synthetic-sql-fixture');
 return jsonb_build_object('id',p_id,'sha256',encode(digest,'hex'),'replayed',false,'local_fixture_only',true);
end $$;

create function public.worker_install_original_executor_policy_v1(p_id uuid,p_canonical_policy text) returns jsonb
language plpgsql security definer set search_path='' as $$
declare d jsonb; digest bytea; old app_private.executor_policies; profile app_private.paper_verification_profiles; k text; useful integer; report integer;
begin
 perform app_private.require_executor_role('science_reader_executor_admitter');
 if p_id is null or p_canonical_policy is null or octet_length(p_canonical_policy)>4096 then raise exception 'invalid_original_policy'; end if;
 d:=p_canonical_policy::jsonb; digest:=sha256(convert_to(p_canonical_policy,'UTF8'));
 perform app_private.original_shape(d,array['version','kind','local_fixture_only','connection_model','max_executors',
  'runner_sha256','transport_sha256','observer_sha256','admission_sha256','max_useful_seconds','max_report_seconds',
  'storage_policy_sha256','spool_policy_sha256','verification_profile_id','verifier_host_policy_sha256','stage_recipes','storage_model'],4096);
 if d->'version' is distinct from '1'::jsonb or d->>'kind' is distinct from 'original-loopback-scope-v1'
  or d->'local_fixture_only' is distinct from 'true'::jsonb or d->>'connection_model' is distinct from 'direct-owned-socket-v1'
  or d->'max_executors' is distinct from '1'::jsonb or d->>'storage_model' is distinct from 'loopback-object-fixture-v1'
  then raise exception 'invalid_original_policy'; end if;
 foreach k in array array['runner_sha256','transport_sha256','observer_sha256','admission_sha256','storage_policy_sha256','spool_policy_sha256','verifier_host_policy_sha256'] loop
  perform app_private.original_hash(d->k);
 end loop;
 perform app_private.original_shape(d->'stage_recipes',array['download','upload','readback','verify'],512);
 foreach k in array array['download','upload','readback','verify'] loop perform app_private.original_hash(d#>array['stage_recipes',k]); end loop;
 useful:=app_private.original_integer(d->'max_useful_seconds',1,120); report:=app_private.original_integer(d->'max_report_seconds',useful,120);
 select * into profile from app_private.paper_verification_profiles where id=app_private.original_uuid(d->'verification_profile_id');
 if profile.id is null or profile.definition->>'kind' is distinct from 'original-loopback-verifier-v1'
  or profile.definition->'local_fixture_only' is distinct from 'true'::jsonb
  or profile.definition->'host_policy_sha256' is distinct from d->'verifier_host_policy_sha256' then raise exception 'invalid_original_policy'; end if;
 perform 1 from app_private.executor_authority where singleton for update;
 select * into old from app_private.executor_policies where id=p_id;
 if found then
  if old.policy_sha256<>digest then raise exception 'operation_id_conflict'; end if;
  return jsonb_build_object('id',p_id,'sha256',encode(digest,'hex'),'replayed',true,'local_fixture_only',true);
 end if;
 if (select count(*) from app_private.executor_policies)>=8 then raise exception 'executor_policy_capacity'; end if;
 insert into app_private.executor_policies(id,policy_sha256,canonical_policy,definition,kind,runner_sha256,transport_sha256,observer_sha256,
  admission_sha256,useful_seconds,report_seconds)
 values(p_id,digest,p_canonical_policy,d,d->>'kind',decode(d->>'runner_sha256','hex'),decode(d->>'transport_sha256','hex'),
  decode(d->>'observer_sha256','hex'),decode(d->>'admission_sha256','hex'),useful,report);
 return jsonb_build_object('id',p_id,'sha256',encode(digest,'hex'),'replayed',false,'local_fixture_only',true);
end $$;

create function public.worker_original_authority_state() returns jsonb language plpgsql stable security definer set search_path='' as $$
begin
 if current_setting('role',true) not in ('science_reader_original_executor','science_reader_pdf_verifier','science_reader_execution_observer','science_reader_executor_admitter')
  then raise exception 'executor_authority_required' using errcode='42501'; end if;
 return (select jsonb_build_object('revision',a.revision,'project_ref',a.project_ref,'environment',a.environment,'epoch',a.epoch,
  'enabled',a.enabled,'original_admitted',a.original_admitted,'recovery_required',a.recovery_required,
  'metadata_policy_id',a.active_policy_id,'original_policy_id',a.original_policy_id,
  'host_id',a.admitted_host_id,'boot_id',a.admitted_boot_id,'metadata_deployment_id',a.admitted_deployment_id,'original_deployment_id',a.original_deployment_id,
  'legacy_unsettled',app_private.legacy_execution_unsettled(),'local_fixture_only',true,
  'unsettled_attempts',(select count(*) from app_private.execution_attempts e where app_private.execution_unsettled(e.id)))
  from app_private.executor_authority a where singleton);
end $$;

create function public.worker_activate_original_executor_v1(p_expected_revision bigint,p_project_ref text,p_metadata_policy_id uuid,p_original_policy_id uuid,
 p_host_id uuid,p_boot_id uuid,p_metadata_deployment_id text,p_original_deployment_id text,p_recovery_evidence_sha256 bytea) returns jsonb
language plpgsql security definer set search_path='' as $$
declare a app_private.executor_authority; ep app_private.executor_policies;
begin
 perform app_private.require_executor_role('science_reader_executor_admitter');
 select * into strict a from app_private.executor_authority where singleton for update;
 if p_expected_revision is distinct from a.revision then raise exception 'stale_executor_authority'; end if;
 select * into ep from app_private.executor_policies where id=p_original_policy_id and kind='original-loopback-scope-v1';
 if a.enabled or ep.id is null or ep.definition->'local_fixture_only' is distinct from 'true'::jsonb
  or p_project_ref is null or p_project_ref!~'^[a-z]{20}$' or (a.project_ref is not null and a.project_ref<>p_project_ref)
  or p_host_id is null or p_boot_id is null or p_metadata_deployment_id is null or p_original_deployment_id is null
  or p_metadata_deployment_id!~'^[A-Za-z0-9_.:-]{1,128}$' or p_original_deployment_id!~'^[A-Za-z0-9_.:-]{1,128}$'
  or p_recovery_evidence_sha256 is null or octet_length(p_recovery_evidence_sha256)<>32
  or not exists(select 1 from app_private.executor_policies where id=p_metadata_policy_id and kind='metadata-linux-scope-v1')
  then raise exception 'invalid_original_activation'; end if;
 if app_private.legacy_execution_unsettled() or exists(select 1 from app_private.execution_attempts e where app_private.execution_unsettled(e.id))
  then raise exception 'executor_recovery_required'; end if;
 update app_private.executor_authority set project_ref=p_project_ref,active_policy_id=p_metadata_policy_id,original_policy_id=p_original_policy_id,
  original_deployment_id=p_original_deployment_id,admitted_deployment_id=p_metadata_deployment_id,admitted_host_id=p_host_id,admitted_boot_id=p_boot_id,
  original_admitted=true,enabled=true,recovery_required=false,epoch=gen_random_uuid(),revision=revision+1,
  recovery_evidence_sha256=p_recovery_evidence_sha256 where singleton;
 update app_private.acquisition_policy set metadata_enabled=true,original_enabled=true,verification_enabled=true,
  active_verification_profile=(ep.definition->>'verification_profile_id')::uuid where singleton;
 return public.worker_original_authority_state();
end $$;

create function app_private.validate_original_executor_binding(b jsonb,a app_private.executor_authority,p app_private.executor_policies,p_claim uuid,p_request bytea) returns void
language plpgsql set search_path='' as $$
declare local_authority app_private.executor_authority:=a; local_policy app_private.executor_policies:=p;
begin
 perform app_private.original_shape(b,array['version','project_ref','environment','epoch','policy_id','runner_sha256','transport_sha256','observer_sha256',
  'deployment_id','host_id','boot_id','process_id','process_start_id','child_id','scope','request_sha256'],2048);
 if b->'version' is distinct from '3'::jsonb or p.kind<>'original-loopback-scope-v1'
  or p.definition->'local_fixture_only' is distinct from 'true'::jsonb or b#>>'{scope,scope_id}' is distinct from p_claim::text
  or app_private.original_hash(b->'request_sha256') is distinct from p_request then raise exception 'invalid_executor_binding'; end if;
 -- Reuse the closed v2 Linux scope/identity validator without changing stored
 -- metadata rows, policy semantics or the original version-3 binding digest.
 local_policy.kind:='metadata-linux-scope-v1'; local_authority.active_policy_id:=a.original_policy_id;
 local_authority.admitted_deployment_id:=a.original_deployment_id;
 perform app_private.validate_metadata_executor_binding((b-'request_sha256')||'{"version":2}'::jsonb,local_authority,local_policy);
end $$;

create function app_private.require_original_job(p_id uuid) returns void language plpgsql stable security definer set search_path='' as $$
begin
 if not exists(select 1 from app_private.acquisition_jobs where id=p_id and kind='original' and execution_contract='original-v1')
 then raise exception 'original_execution_contract_required'; end if;
end $$;
create function app_private.original_envelope(p_id uuid) returns void language plpgsql stable security definer set search_path='' as $$
declare n bigint; k text;
begin
 perform app_private.require_original_job(p_id);
 if (select slots_held from app_private.acquisition_jobs where id=p_id)<>28 then raise exception 'execution_envelope_integrity'; end if;
 foreach k in array array['original_download','original_upload','original_readback','original_verify'] loop
  if (select count(*) from app_private.execution_attempts where job_id=p_id and kind=k)>
   (case when k in ('original_download','original_readback') then 2 else 1 end) then raise exception 'acquisition_attempt_limit'; end if;
 end loop;
 select (select count(*) from app_private.acquisition_steps where job_id=p_id)
  +(select count(*) from app_private.execution_attempts where job_id=p_id)
  +(select coalesce(sum(cardinality(app_private.execution_resources(kind))),0) from app_private.execution_attempts where job_id=p_id)
  +(select count(*) from app_private.paper_asset_reservations where job_id=p_id)
  +1+1+case when exists(select 1 from app_private.acquisition_steps where job_id=p_id and kind='original_publish_v1') then 0 else 1 end into n;
 if n>28 or (select count(*) from app_private.paper_asset_reservations where job_id=p_id)>1
  or (select count(*) from app_private.acquisition_steps where job_id=p_id)>8
  or (select count(*) from app_private.paper_verification_results v join app_private.paper_asset_reservations r on r.id=v.reservation_id where r.job_id=p_id)>1
  or (select count(*) from app_private.paper_integrity_failures v join app_private.paper_asset_reservations r on r.id=v.reservation_id where r.job_id=p_id)>1
 then raise exception 'execution_envelope_integrity'; end if;
end $$;

-- Returns the next immutable input, never a grant. Its hash is deliberately
-- opaque SQL jsonb::text SHA-256; clients freeze/compare it without re-encoding.
create function app_private.original_next_request(p_id uuid) returns jsonb language plpgsql stable security definer set search_path='' as $$
declare j app_private.acquisition_jobs; r app_private.paper_asset_reservations; s app_private.acquisition_steps;
 base app_private.acquisition_steps; previous app_private.execution_attempts; d jsonb; ep app_private.executor_policies; v app_private.paper_verification_profiles; source_spool text; expected text;
begin
 perform app_private.require_original_job(p_id);
 select * into j from app_private.acquisition_jobs where id=p_id;
 if j.stage not in ('download','upload','readback','pending_verification') or j.status not in ('queued','retry_wait') then return null; end if;
 select * into r from app_private.paper_asset_reservations where job_id=j.id;
 if not found then return null; end if;
 select * into s from app_private.acquisition_steps where job_id=j.id order by generation desc,created_at desc,operation_id desc limit 1;
 if s.result is null then return null; end if;
 base:=s;
 if s.result->>'kind' in ('original_failure_v1','original_expired_v1') then
  select * into previous from app_private.execution_attempts where job_id=j.id and operation_id=s.operation_id;
  if previous.kind is distinct from 'original_'||j.stage or j.stage not in ('download','readback') then return null; end if;
  select * into base from app_private.acquisition_steps where job_id=j.id and operation_id=previous.predecessor_operation_id
   and result_sha256=previous.predecessor_result_sha256;
 end if;
 expected:=case j.stage when 'download' then 'original_reserve_v1' when 'upload' then 'original_download_v1'
  when 'readback' then 'original_upload_v1' when 'pending_verification' then 'original_readback_v1' end;
 if base.result->>'kind' is distinct from expected then raise exception 'original_predecessor_integrity'; end if;
 if j.stage in ('upload','pending_verification') then source_spool:=base.result->>'spool_descriptor_sha256'; end if;
 select * into strict ep from app_private.executor_policies where id=j.original_policy_id;
 select * into strict v from app_private.paper_verification_profiles where id=r.verification_profile_id;
 d:=jsonb_build_object('version',1,'kind',case j.stage when 'pending_verification' then 'original_verify' else 'original_'||j.stage end,
  'job_id',j.id,'reservation_id',r.id,'source_id',j.source_id,'source_revision',j.source_revision,
  'bucket','paper-assets','path',r.path,'predecessor_operation_id',s.operation_id,'predecessor_result_sha256',encode(s.result_sha256,'hex'),
  'candidate_sha256',encode(r.candidate_sha256,'hex'),'candidate_bytes',r.candidate_bytes,
  'input_spool_sha256',source_spool,'byte_ceiling',case when j.stage in ('upload','pending_verification') then r.candidate_bytes else r.max_bytes end,
  'verification_profile_id',r.verification_profile_id,'build_sha256',encode(v.build_sha256,'hex'),
  'parser_profile_sha256',v.definition->'parser_profile_sha256','verifier_host_policy_sha256',ep.definition->'verifier_host_policy_sha256',
  'storage_policy_sha256',ep.definition->'storage_policy_sha256','spool_policy_sha256',ep.definition->'spool_policy_sha256','stage_recipe_sha256',ep.definition#>array['stage_recipes',case j.stage when 'pending_verification' then 'verify' else j.stage end]);
 if octet_length(d::text)>2048 then raise exception 'original_request_limit'; end if;
 return d;
end $$;
create function public.worker_original_job_state(p_job_id uuid) returns jsonb language plpgsql stable security definer set search_path='' as $$
declare d jsonb;
begin
 if current_setting('role',true) not in ('science_reader_original_executor','science_reader_pdf_verifier','science_reader_execution_observer','science_reader_executor_admitter')
 then raise exception 'executor_authority_required' using errcode='42501'; end if;
 perform app_private.require_original_job(p_job_id); d:=app_private.original_next_request(p_job_id);
 return jsonb_build_object('job',app_private.acquisition_job_entry(p_job_id),
  'reservation',(select app_private.original_reservation_entry(id) from app_private.paper_asset_reservations where job_id=p_job_id),
  'next_request',d,'request_sha256',case when d is not null then encode(sha256(convert_to(d::text,'UTF8')),'hex') end,'local_fixture_only',true);
end $$;
create function public.worker_original_execution_state(p_job_id uuid,p_claim_id uuid) returns jsonb language plpgsql stable security definer set search_path='' as $$
begin
 if current_setting('role',true) not in ('science_reader_original_executor','science_reader_pdf_verifier','science_reader_execution_observer','science_reader_executor_admitter')
 then raise exception 'executor_authority_required' using errcode='42501'; end if;
 perform app_private.require_original_job(p_job_id);
 if p_claim_id is null then raise exception 'invalid_acquisition_claim'; end if;
 return jsonb_build_object('job',app_private.acquisition_job_entry(p_job_id),
  'execution',(select app_private.execution_entry(id) from app_private.execution_attempts where job_id=p_job_id and operation_id=p_claim_id),
  'step_result',(select result from app_private.acquisition_steps where job_id=p_job_id and operation_id=p_claim_id));
end $$;

create function public.worker_prepare_original_v1(p_operation_id uuid,p_lookup_job_id uuid) returns jsonb
language plpgsql security definer set search_path='' as $$
declare digest bytea; command app_private.acquisition_commands; l app_private.acquisition_jobs; j app_private.acquisition_jobs; chosen uuid;
begin
 perform app_private.require_executor_role('science_reader_original_executor');
 if p_operation_id is null or p_lookup_job_id is null then raise exception 'invalid_acquisition_request'; end if;
 digest:=sha256(convert_to(jsonb_build_array('original-v1',p_lookup_job_id)::text,'UTF8'));
 perform 1 from app_private.acquisition_policy where singleton for update;
 select * into command from app_private.acquisition_commands where id=p_operation_id;
 if found then
  if command.request_sha256<>digest then raise exception 'operation_id_conflict'; end if;
  perform app_private.require_original_job(command.job_id);
  return jsonb_build_object('job',app_private.acquisition_job_entry(command.job_id),'replayed',true);
 end if;
 select * into l from app_private.acquisition_jobs where id=p_lookup_job_id and kind='lookup';
 if not found or l.status<>'complete' or l.eligibility is distinct from 'eligible' or l.metadata_id is null then raise exception 'acquisition_eligibility_required'; end if;
 select * into j from app_private.acquisition_jobs where kind='original' and version_id=l.version_id and reuse_policy=l.reuse_policy
  and acquisition_profile=l.acquisition_profile and status in ('queued','leased','retry_wait','blocked','complete')
 order by case when status='complete' then 0 else 1 end,created_at,id limit 1 for no key update;
 if found then
  if j.execution_contract<>'original-v1' then raise exception 'legacy_original_requires_review'; end if;
  chosen:=j.id; perform app_private.acquisition_admit(0,false);
 else
  perform app_private.acquisition_admit(28,false); chosen:=p_operation_id;
  insert into app_private.acquisition_jobs(id,kind,source_id,requested_revision,input_sha256,metadata_id,version_id,source_revision,
   atom_published_at,atom_updated_at,eligibility,license_uri,evidence,stage,slots_held,execution_contract)
  values(chosen,'original',l.source_id,l.source_revision,digest,l.metadata_id,l.version_id,l.source_revision,
   l.atom_published_at,l.atom_updated_at,l.eligibility,l.license_uri,l.evidence,'reserve',28,'original-v1');
 end if;
 insert into app_private.acquisition_commands(id,request_sha256,job_id) values(p_operation_id,digest,chosen);
 return jsonb_build_object('job',app_private.acquisition_job_entry(chosen),'replayed',false);
end $$;

create function public.worker_reserve_original_v1(p_job_id uuid,p_operation_id uuid,p_reservation_id uuid) returns jsonb
language plpgsql security definer set search_path='' as $$
declare a app_private.executor_authority; ep app_private.executor_policies; j app_private.acquisition_jobs; r app_private.paper_asset_reservations;
 s app_private.acquisition_steps; p app_private.acquisition_policy; c app_private.paper_storage_capacity; v app_private.paper_verification_profiles;
 digest bytea; total_bytes bigint; objects bigint; ceiling bigint; started timestamptz;
begin
 perform app_private.require_executor_role('science_reader_original_executor');
 if p_job_id is null or p_operation_id is null or p_reservation_id is null then raise exception 'invalid_original_reservation'; end if;
 digest:=sha256(convert_to(jsonb_build_array('original-reserve-v1',p_job_id,p_operation_id,p_reservation_id)::text,'UTF8'));
 select * into strict a from app_private.executor_authority where singleton for update;
 select * into strict c from app_private.paper_storage_capacity where singleton for update;
 select * into j from app_private.acquisition_jobs where id=p_job_id for no key update;
 perform app_private.require_original_job(p_job_id);
 select * into s from app_private.acquisition_steps where job_id=j.id and operation_id=p_operation_id;
 if found then
  if s.request_sha256<>digest or s.kind<>'original_reserve_v1' then raise exception 'operation_id_conflict'; end if;
  return jsonb_build_object('job',app_private.acquisition_job_entry(j.id),'reservation',app_private.original_reservation_entry(p_reservation_id),'replayed',true);
 end if;
 select * into strict p from app_private.acquisition_policy;
 select * into ep from app_private.executor_policies where id=a.original_policy_id and kind='original-loopback-scope-v1';
 if not a.enabled or a.recovery_required or not a.original_admitted or ep.id is null or not p.original_enabled or not p.verification_enabled
  or p.active_verification_profile is distinct from (ep.definition->>'verification_profile_id')::uuid then raise exception 'original_acquisition_disabled'; end if;
 select * into strict v from app_private.paper_verification_profiles where id=p.active_verification_profile;
 if j.stage<>'reserve' or j.status<>'queued' or j.generation<>0 or j.eligibility is distinct from 'eligible'
  or exists(select 1 from app_private.paper_asset_reservations where job_id=j.id) then raise exception 'invalid_original_stage'; end if;
 if not app_private.acquisition_has_interest(j.id) then raise exception 'acquisition_interest_required'; end if;
 if app_private.legacy_execution_unsettled() then raise exception 'executor_recovery_required'; end if;
 ceiling:=least(c.input_max_bytes,v.max_bytes);
 select coalesce(sum(byte_count),0),count(*) into total_bytes,objects from app_private.stored_objects where bucket='paper-assets' and state<>'deleted';
 select total_bytes+coalesce(sum(held_bytes),0),objects+count(*) into total_bytes,objects from app_private.paper_asset_reservations where state not in ('published','deleted');
 if total_bytes+ceiling>c.max_bytes or objects+1>c.max_objects then raise exception 'original_storage_capacity'; end if;
 -- Quarantine is not retirement. A retained fixture reservation remains active;
 -- this version supplies no remote-delete or automatic garbage collection path.
 if (select count(*) from app_private.paper_asset_reservations where state not in ('published','deleted'))>=c.active_reservations then raise exception 'original_concurrency_limit'; end if;
 started:=clock_timestamp();
 insert into app_private.acquisition_steps(job_id,operation_id,request_sha256,kind,generation,stage)
 values(j.id,p_operation_id,digest,'original_reserve_v1',1,'reserve');
 insert into app_private.paper_asset_reservations(id,job_id,operation_id,request_sha256,generation,path,max_bytes,held_bytes,verification_profile_id,expires_at,safe_after)
 values(p_reservation_id,j.id,p_operation_id,digest,1,'originals/'||p_reservation_id||'/original.pdf',ceiling,ceiling,v.id,started+interval '24 hours',started);
 perform app_private.acquisition_finish_step(j.id,p_operation_id,jsonb_build_object('kind','original_reserve_v1','reservation_id',p_reservation_id));
 update app_private.acquisition_jobs set stage='download',status='queued',generation=1,state_revision=state_revision+1,
  original_policy_id=ep.id,original_deployment_id=a.original_deployment_id,original_host_id=a.admitted_host_id,original_boot_id=a.admitted_boot_id,
  next_attempt_at=started where id=j.id;
 perform app_private.original_envelope(j.id);
 return jsonb_build_object('job',app_private.acquisition_job_entry(j.id),'reservation',app_private.original_reservation_entry(p_reservation_id),'replayed',false);
end $$;

create function public.worker_claim_original_stage_v1(p_job_id uuid,p_claim_id uuid,p_environment text,p_stage text,p_expected_request_sha256 bytea,p_executor_binding jsonb) returns jsonb
language plpgsql security definer set search_path='' as $$
declare a app_private.executor_authority; ep app_private.executor_policies; j app_private.acquisition_jobs; r app_private.paper_asset_reservations;
 s app_private.acquisition_steps; e app_private.execution_attempts; p app_private.acquisition_policy; c app_private.paper_storage_capacity;
 g app_private.arxiv_network_gate; v app_private.paper_verification_profiles; d jsonb; request_hash bytea; digest bytea; desired text;
 k text; ceiling bigint; used bigint; carry bigint; charge_month date; day date; started timestamptz; attempt uuid; useful timestamptz; report timestamptz; n bigint;
begin
 if p_stage='original_verify' then perform app_private.require_executor_role('science_reader_pdf_verifier');
 else perform app_private.require_executor_role('science_reader_original_executor'); end if;
 if p_job_id is null or p_claim_id is null or p_environment is null or p_stage is null
  or p_stage not in ('original_download','original_upload','original_readback','original_verify')
  or p_expected_request_sha256 is null or octet_length(p_expected_request_sha256)<>32
  or p_executor_binding is null or octet_length(p_executor_binding::text)>2048 then raise exception 'invalid_acquisition_claim'; end if;
 digest:=sha256(convert_to(jsonb_build_array('original-stage-v1',p_job_id,p_claim_id,p_environment,p_stage,encode(p_expected_request_sha256,'hex'),p_executor_binding)::text,'UTF8'));
 select * into strict a from app_private.executor_authority where singleton for update;
 select * into strict c from app_private.paper_storage_capacity where singleton for update;
 if p_stage='original_download' then select * into strict g from app_private.arxiv_network_gate where singleton for update; end if;
 select * into j from app_private.acquisition_jobs where id=p_job_id for no key update;
 perform app_private.require_original_job(p_job_id);
 select * into s from app_private.acquisition_steps where job_id=j.id and operation_id=p_claim_id;
 if found then
  if s.kind<>'original_stage_v1' or s.request_sha256<>digest then raise exception 'operation_id_conflict'; end if;
  select * into strict e from app_private.execution_attempts where job_id=j.id and operation_id=p_claim_id;
  return jsonb_build_object('granted',false,'action','reconcile','replayed',true,'job',app_private.acquisition_job_entry(j.id),'execution',app_private.execution_entry(e.id));
 end if;
 select * into r from app_private.paper_asset_reservations where job_id=j.id for no key update;
 if not found then raise exception 'original_reservation_unavailable'; end if;
 select * into strict p from app_private.acquisition_policy;
 select * into ep from app_private.executor_policies where id=a.original_policy_id and kind='original-loopback-scope-v1';
 if not a.enabled or a.recovery_required or not a.original_admitted or ep.id is null or not p.original_enabled or not p.verification_enabled
  or p.gateway_environment<>p_environment or p.active_verification_profile is distinct from r.verification_profile_id
  then return jsonb_build_object('granted',false,'action','disabled','job',app_private.acquisition_job_entry(j.id)); end if;
 if (j.original_policy_id,j.original_deployment_id,j.original_host_id,j.original_boot_id)
  is distinct from (ep.id,a.original_deployment_id,a.admitted_host_id,a.admitted_boot_id) then raise exception 'original_policy_pin_mismatch'; end if;
 perform app_private.validate_original_executor_binding(p_executor_binding,a,ep,p_claim_id,p_expected_request_sha256);
 desired:=case p_stage when 'original_verify' then 'pending_verification' else substr(p_stage,10) end;
 if j.stage<>desired then raise exception 'invalid_original_stage'; end if;
 if j.status in ('complete','failed','blocked','no_interest') or r.expires_at<=clock_timestamp()
  or j.created_at+make_interval(secs=>p.retry_age_seconds)<=clock_timestamp()
 then return jsonb_build_object('granted',false,'action','terminal','job',app_private.acquisition_job_entry(j.id)); end if;
 if app_private.legacy_execution_unsettled()
  or exists(select 1 from app_private.execution_attempts x where app_private.execution_pending(x.id,'executor')
   or (x.job_id=j.id and app_private.execution_unsettled(x.id)))
  or (p_stage='original_download' and (g.token is not null or exists(select 1 from app_private.execution_attempts x where app_private.execution_pending(x.id,'arxiv_connection'))))
 then return jsonb_build_object('granted',false,'action','wait','reason','unsettled_execution','next_allowed_at',null,'job',app_private.acquisition_job_entry(j.id)); end if;
 if j.status='leased' or j.next_attempt_at>clock_timestamp() or (p_stage='original_download' and g.next_allowed_at>clock_timestamp())
 then return jsonb_build_object('granted',false,'action','wait','reason','cooldown','next_allowed_at',greatest(j.next_attempt_at,j.lease_until,g.next_allowed_at),'job',app_private.acquisition_job_entry(j.id)); end if;
 if j.status not in ('queued','retry_wait') then raise exception 'invalid_original_stage'; end if;
 d:=app_private.original_next_request(j.id); request_hash:=sha256(convert_to(d::text,'UTF8'));
 if d is null or request_hash is distinct from p_expected_request_sha256 or d->>'kind'<>p_stage then raise exception 'original_request_changed'; end if;
 select count(*) into n from app_private.execution_attempts where job_id=j.id and kind=p_stage;
 if n>=(case when p_stage in ('original_download','original_readback') then 2 else 1 end) then return jsonb_build_object('granted',false,'action','terminal'); end if;
 if exists(select 1 from app_private.execution_attempts x where x.child_id=(p_executor_binding->>'child_id')::uuid
  or (x.host_id,x.boot_id,x.process_id,x.process_start_id)=((p_executor_binding->>'host_id')::uuid,(p_executor_binding->>'boot_id')::uuid,(p_executor_binding->>'process_id')::bigint,p_executor_binding->>'process_start_id')
  or (x.host_id,x.boot_id,x.scope_id)=((p_executor_binding->>'host_id')::uuid,(p_executor_binding->>'boot_id')::uuid,p_claim_id)) then raise exception 'executor_binding_already_used'; end if;
 ceiling:=(d->>'byte_ceiling')::bigint;
 k:=case p_stage when 'original_download' then 'source_bytes' when 'original_upload' then 'object_upload_bytes' when 'original_readback' then 'worker_bytes' end;
 if k is not null then
  perform 1 from app_private.acquisition_transfer_capacity where singleton for update;
  day:=(clock_timestamp() at time zone 'UTC')::date; charge_month:=date_trunc('month',clock_timestamp() at time zone 'UTC')::date;
  perform 1 from app_private.acquisition_transfer_windows w where w.scope='environment'
   and ((w.period=charge_month and w.kind=k) or (p_stage='original_download' and w.period=day and w.kind='source_requests'))
   order by w.period,w.scope,w.kind for no key update;
 end if;
 -- The final statement snapshot follows ALL potentially waiting admission
 -- locks. No policy/account mutex is acquired after a job or transfer row.
 select * into strict p from app_private.acquisition_policy;
 if not p.original_enabled or not p.verification_enabled or p.gateway_environment<>p_environment
  or p.active_verification_profile is distinct from r.verification_profile_id
  or ep.definition->>'verification_profile_id' is distinct from r.verification_profile_id::text
 then return jsonb_build_object('granted',false,'action','disabled','job',app_private.acquisition_job_entry(j.id)); end if;
 if not app_private.acquisition_has_interest(j.id) then return jsonb_build_object('granted',false,'action','no_interest','job',app_private.acquisition_job_entry(j.id)); end if;
 if r.expires_at<=clock_timestamp() or j.created_at+make_interval(secs=>p.retry_age_seconds)<=clock_timestamp()
 then return jsonb_build_object('granted',false,'action','terminal','job',app_private.acquisition_job_entry(j.id)); end if;
 if k is not null then
  select coalesce(sum(x.byte_ceiling),0) into carry from app_private.execution_attempts x
   where x.charge_period<>charge_month and (case k when 'source_bytes' then x.kind in ('atom','license','original_download') and app_private.execution_pending(x.id,'arxiv_connection')
    when 'object_upload_bytes' then x.kind='original_upload' and app_private.execution_pending(x.id,'object_write')
    else x.kind='original_readback' and app_private.execution_pending(x.id,'object_read') end);
  select coalesce((select w.charged from app_private.acquisition_transfer_windows w where w.period=charge_month and w.scope='environment' and w.kind=k),0) into used;
  if used+carry+ceiling>(case k when 'worker_bytes' then p.worker_read_bytes_month else p.source_download_bytes_month end)
   then raise exception 'original_transfer_limit'; end if;
  if p_stage='original_download' then
   insert into app_private.acquisition_transfer_windows(period,scope,kind,charged) values(day,'environment','source_requests',1)
    on conflict(period,scope,kind) do update set charged=app_private.acquisition_transfer_windows.charged+1 returning charged into used;
   if used>p.source_requests_day then raise exception 'arxiv_daily_limit'; end if;
  end if;
  insert into app_private.acquisition_transfer_windows(period,scope,kind,charged) values(charge_month,'environment',k,ceiling)
   on conflict(period,scope,kind) do update set charged=app_private.acquisition_transfer_windows.charged+excluded.charged;
 end if;
 select * into strict v from app_private.paper_verification_profiles where id=r.verification_profile_id;
 started:=clock_timestamp(); attempt:=gen_random_uuid();
 useful:=started+make_interval(secs=>least(ep.useful_seconds,p.stage_lease_seconds,case when p_stage='original_verify' then v.wall_ms::double precision/1000 else 120 end));
 report:=started+make_interval(secs=>least(ep.report_seconds,p.stage_lease_seconds));
 insert into app_private.acquisition_steps(job_id,operation_id,request_sha256,kind,generation,stage,network_token,network_granted_at,network_byte_ceiling,network_period)
 values(j.id,p_claim_id,digest,'original_stage_v1',j.generation+1,j.stage,case when p_stage='original_download' then attempt end,
  case when p_stage='original_download' then started end,case when p_stage='original_download' then ceiling end,case when p_stage='original_download' then charge_month end);
 insert into app_private.execution_attempts(id,job_id,operation_id,generation,kind,request_sha256,epoch,policy_id,project_ref,environment,binding,binding_sha256,
  host_id,boot_id,process_id,process_start_id,child_id,scope_id,useful_deadline,report_deadline,byte_ceiling,charge_period,created_at,
  reservation_id,predecessor_operation_id,predecessor_result_sha256,original_request,original_request_sha256,candidate_sha256,candidate_bytes,input_spool_sha256,
  verification_generation,charge_kind,request_day)
 values(attempt,j.id,p_claim_id,j.generation+1,p_stage,digest,a.epoch,ep.id,a.project_ref,a.environment,p_executor_binding,sha256(convert_to(p_executor_binding::text,'UTF8')),
  a.admitted_host_id,a.admitted_boot_id,(p_executor_binding->>'process_id')::bigint,p_executor_binding->>'process_start_id',(p_executor_binding->>'child_id')::uuid,p_claim_id,
  useful,report,ceiling,charge_month,started,r.id,(d->>'predecessor_operation_id')::uuid,decode(d->>'predecessor_result_sha256','hex'),d,request_hash,
  r.candidate_sha256,r.candidate_bytes,decode(d->>'input_spool_sha256','hex'),case when p_stage='original_verify' then r.verification_generation+1 end,k,
  case when p_stage='original_download' then day end);
 update app_private.acquisition_jobs set generation=generation+1,claim_id=p_claim_id,status='leased',state_revision=state_revision+1,
  lease_until=report,hard_deadline=null,download_attempts=download_attempts+case when p_stage='original_download' then 1 else 0 end where id=j.id;
 update app_private.paper_asset_reservations set generation=j.generation+1,safe_after=greatest(safe_after,report),
  state=case p_stage when 'original_upload' then 'uploading' when 'original_verify' then 'verifying' else state end,
  verification_generation=verification_generation+case when p_stage='original_verify' then 1 else 0 end,
  verification_attempts=verification_attempts+case when p_stage='original_verify' then 1 else 0 end,
  verification_claim=case when p_stage='original_verify' then p_claim_id else verification_claim end,
  verification_execution_deadline=case when p_stage='original_verify' then useful else verification_execution_deadline end,
  verification_lease_until=case when p_stage='original_verify' then report else verification_lease_until end where id=r.id;
 if p_stage='original_download' then update app_private.arxiv_network_gate set token=attempt,job_id=j.id,operation_id=p_claim_id,generation=generation+1,
  granted_at=started,hard_deadline=null where singleton; end if;
 perform app_private.original_envelope(j.id);
 return jsonb_build_object('granted',true,'action','perform_stage','local_fixture_only',true,'job',app_private.acquisition_job_entry(j.id),'execution',app_private.execution_entry(attempt));
end $$;

create function app_private.original_scope_facts(f jsonb,e app_private.execution_attempts) returns void language plpgsql immutable set search_path='' as $$
declare k text;
begin
 if f->>'binding_sha256' is distinct from encode(e.binding_sha256,'hex') or f->>'scope_id' is distinct from e.scope_id::text
  or f->'capture_sha256' is distinct from e.binding#>'{scope,capture_sha256}' then raise exception 'execution_evidence_binding'; end if;
 foreach k in array array['binding_sha256','capture_sha256','fence_sha256','observation_sha256'] loop perform app_private.original_hash(f->k); end loop;
 perform app_private.original_uuid(f->'scope_id');
end $$;
create function public.worker_record_original_quiescence(p_attempt_id uuid,p_receipt_id uuid,p_resource text,p_evidence_kind text,p_facts jsonb) returns jsonb
language plpgsql security definer set search_path='' as $$
declare e app_private.execution_attempts; q app_private.execution_quiescence; executor_receipt app_private.execution_quiescence;
 s app_private.acquisition_steps; g app_private.arxiv_network_gate; ep app_private.executor_policies; digest bytea; measured bigint; retry integer:=0; frame text;
 scope_keys text[]:=array['binding_sha256','scope_id','capture_sha256','fence_sha256','observation_sha256']; key text;
begin
 perform app_private.require_executor_role('science_reader_execution_observer');
 if p_attempt_id is null or p_receipt_id is null or p_resource is null or p_evidence_kind is null or p_facts is null
  or jsonb_typeof(p_facts)<>'object' or octet_length(p_facts::text)>2048 then raise exception 'invalid_execution_evidence'; end if;
 digest:=sha256(convert_to(jsonb_build_array('original-quiescence-v1',p_attempt_id,p_resource,p_evidence_kind,p_facts)::text,'UTF8'));
 perform 1 from app_private.executor_authority where singleton for update;
 if p_resource='arxiv_connection' then select * into strict g from app_private.arxiv_network_gate where singleton for update; end if;
 select * into e from app_private.execution_attempts where id=p_attempt_id;
 if not found then raise exception 'execution_unavailable'; end if;
 perform app_private.require_original_job(e.job_id);
 if e.kind not like 'original_%' or not (p_resource=any(app_private.execution_resources(e.kind))) then raise exception 'invalid_execution_resource'; end if;
 select * into q from app_private.execution_quiescence where receipt_id=p_receipt_id;
 if found then
  if q.request_sha256<>digest then raise exception 'operation_id_conflict'; end if;
  return jsonb_build_object('replayed',true,'receipt_id',q.receipt_id,'execution',app_private.execution_entry(e.id));
 end if;
 select * into q from app_private.execution_quiescence where attempt_id=e.id and resource=p_resource;
 if found then
  if q.request_sha256<>digest then raise exception 'operation_id_conflict'; end if;
  return jsonb_build_object('replayed',true,'receipt_id',q.receipt_id,'execution',app_private.execution_entry(e.id));
 end if;
 select * into strict ep from app_private.executor_policies where id=e.policy_id;
 if ep.kind<>'original-loopback-scope-v1' or ep.definition->'local_fixture_only' is distinct from 'true'::jsonb then raise exception 'original_policy_required'; end if;
 perform app_private.original_scope_facts(p_facts,e);
 if p_resource='executor' then
  if p_evidence_kind<>'owned_scope_retired_v1' then raise exception 'invalid_execution_evidence'; end if;
  perform app_private.original_shape(p_facts,scope_keys,2048);
 else
  select * into executor_receipt from app_private.execution_quiescence where attempt_id=e.id and resource='executor';
  if not found then raise exception 'executor_retirement_required'; end if;
  foreach key in array scope_keys loop
   if p_facts->key is distinct from executor_receipt.facts->key then raise exception 'execution_evidence_binding'; end if;
  end loop;
  if p_resource='object_write' then
   if p_evidence_kind<>'storage_upload_ack_v1' then raise exception 'object_write_ack_required'; end if;
   perform app_private.original_shape(p_facts,scope_keys||array['bucket','path','sha256','byte_count','storage_policy_sha256','ack_sha256','status_code','response_complete'],2048);
   if p_facts->>'bucket' is distinct from 'paper-assets' or p_facts->'path' is distinct from e.original_request->'path'
    or app_private.original_hash(p_facts->'sha256') is distinct from e.candidate_sha256
    or app_private.original_integer(p_facts->'byte_count',1,5242880) is distinct from e.candidate_bytes
    or p_facts->'storage_policy_sha256' is distinct from ep.definition->'storage_policy_sha256'
    or p_facts->'status_code' is distinct from '201'::jsonb or p_facts->'response_complete' is distinct from 'true'::jsonb
   then raise exception 'invalid_storage_ack'; end if;
   perform app_private.original_hash(p_facts->'ack_sha256');
  else
   perform app_private.original_shape(p_facts,scope_keys||array['framing','peer_eof','actual_bytes','body_sha256','status_code','retry_after_seconds'],2048);
   retry:=app_private.original_integer(p_facts->'retry_after_seconds',0,86400); frame:=p_facts->>'framing';
   if p_evidence_kind='owned_scope_retired_v1' then
    if frame is distinct from 'unknown' or p_facts->'peer_eof' is distinct from 'false'::jsonb
     or p_facts->'actual_bytes' is distinct from 'null'::jsonb or p_facts->'body_sha256' is distinct from 'null'::jsonb
    then raise exception 'invalid_execution_evidence'; end if;
    if p_facts->'status_code'<>'null'::jsonb then perform app_private.original_integer(p_facts->'status_code',100,599); end if;
   elsif p_evidence_kind='original_transfer_complete_v1' then
    if frame is null or frame not in ('content_length','chunked','close_delimited','no_body')
     or jsonb_typeof(p_facts->'peer_eof') is distinct from 'boolean'
     or (frame='close_delimited' and p_facts->'peer_eof'<>'true'::jsonb) then raise exception 'invalid_execution_evidence'; end if;
    measured:=app_private.original_integer(p_facts->'actual_bytes',0,e.byte_ceiling);
    perform app_private.original_hash(p_facts->'body_sha256'); perform app_private.original_integer(p_facts->'status_code',100,599);
    if frame='no_body' and measured<>0 then raise exception 'invalid_execution_evidence'; end if;
   else raise exception 'invalid_execution_evidence'; end if;
  end if;
 end if;
 if p_resource='arxiv_connection' then
  select * into strict s from app_private.acquisition_steps where job_id=e.job_id and operation_id=e.operation_id for no key update;
  if s.network_token is distinct from e.id or s.network_closed_at is not null or g.token is distinct from e.id then raise exception 'execution_gate_integrity'; end if;
 end if;
 insert into app_private.execution_quiescence(attempt_id,resource,receipt_id,request_sha256,evidence_kind,facts)
 values(e.id,p_resource,p_receipt_id,digest,p_evidence_kind,p_facts);
 if p_resource in ('arxiv_connection','object_read') and measured is not null then
  update app_private.acquisition_transfer_windows set charged=charged-(e.byte_ceiling-measured)
   where period=e.charge_period and scope='environment' and kind=e.charge_kind and charged>=e.byte_ceiling-measured;
  if not found then raise exception 'execution_charge_integrity'; end if;
 end if;
 if p_resource='arxiv_connection' then
  update app_private.acquisition_steps set network_closed_at=clock_timestamp(),network_actual_bytes=measured,network_retry_after_seconds=retry
   where job_id=e.job_id and operation_id=e.operation_id;
  update app_private.arxiv_network_gate set token=null,job_id=null,operation_id=null,granted_at=null,hard_deadline=null,
   next_allowed_at=greatest(next_allowed_at,clock_timestamp()+make_interval(secs=>greatest(3,retry))) where singleton;
 end if;
 return jsonb_build_object('replayed',false,'receipt_id',p_receipt_id,'execution',app_private.execution_entry(e.id));
end $$;

create function app_private.validate_original_spool(d jsonb,expected bytea,e app_private.execution_attempts,purpose text) returns void
language plpgsql immutable set search_path='' as $$
declare f jsonb; k text;
begin
 perform app_private.original_shape(d,array['format','reservation_id','claim_id','purpose','attempt_id','request_sha256','binding_sha256','capture_sha256','sha256','bytes','producer','guardian'],4096);
 if d->>'format' is distinct from 'original-spool-v1' or d->>'purpose' is distinct from purpose
  or app_private.original_uuid(d->'reservation_id')<>e.reservation_id or app_private.original_uuid(d->'claim_id')<>e.operation_id
  or app_private.original_uuid(d->'attempt_id')<>e.id or app_private.original_hash(d->'request_sha256')<>e.original_request_sha256
  or app_private.original_hash(d->'binding_sha256')<>e.binding_sha256 or d->'capture_sha256' is distinct from e.binding#>'{scope,capture_sha256}'
  or expected is distinct from sha256(convert_to(app_private.original_compact_json(d)||E'\n','UTF8')) then raise exception 'invalid_original_spool'; end if;
 perform app_private.original_hash(d->'sha256'); perform app_private.original_hash(d->'capture_sha256');
 perform app_private.original_integer(d->'bytes',1,e.byte_ceiling);
 foreach k in array array['producer','guardian'] loop
  f:=d->k; perform app_private.original_shape(f,array['device','inode'],128);
  if jsonb_typeof(f->'device') is distinct from 'string' or f->>'device'!~'^(0|[1-9][0-9]{0,19})$'
   or jsonb_typeof(f->'inode') is distinct from 'string' or f->>'inode'!~'^[1-9][0-9]{0,19}$'
   or (f->>'device')::numeric>18446744073709551615 or (f->>'inode')::numeric>18446744073709551615 then raise exception 'invalid_original_spool'; end if;
 end loop;
 if d->'producer'=d->'guardian' then raise exception 'invalid_original_spool'; end if;
end $$;

-- Called only after the authority -> paper -> job -> reservation locks. Late
-- closure has its own path; current generation is solely result authority.
create function app_private.original_current(e app_private.execution_attempts,j app_private.acquisition_jobs,r app_private.paper_asset_reservations,a app_private.executor_authority) returns void
language plpgsql volatile set search_path='' as $$
declare p app_private.acquisition_policy;
begin
 select * into strict p from app_private.acquisition_policy;
 if e.id is null or e.job_id is distinct from j.id or e.reservation_id is distinct from r.id or e.operation_id is distinct from j.claim_id
  or e.generation is distinct from j.generation or j.status<>'leased' or e.report_deadline<=clock_timestamp()
  or a.epoch is distinct from e.epoch or not a.enabled or not a.original_admitted or a.recovery_required
  or a.original_policy_id is distinct from e.policy_id or a.original_policy_id is distinct from j.original_policy_id
  or (a.original_deployment_id,a.admitted_host_id,a.admitted_boot_id) is distinct from (j.original_deployment_id,j.original_host_id,j.original_boot_id)
  or not p.original_enabled or not p.verification_enabled or p.active_verification_profile is distinct from r.verification_profile_id
 then raise exception 'stale_execution_attempt'; end if;
end $$;
create function public.worker_finish_original_stage_v1(p_job_id uuid,p_claim_id uuid,p_generation bigint,p_attempt_id uuid,p_result jsonb) returns jsonb
language plpgsql security definer set search_path='' as $$
declare a app_private.executor_authority; j app_private.acquisition_jobs; r app_private.paper_asset_reservations;
 e app_private.execution_attempts; s app_private.acquisition_steps; q app_private.execution_quiescence; descriptor jsonb;
begin
 perform app_private.require_executor_role('science_reader_original_executor');
 if p_attempt_id is null or p_result is null or octet_length(p_result::text)>4096 then raise exception 'invalid_original_result'; end if;
 select * into strict a from app_private.executor_authority where singleton for update;
 perform 1 from app_private.paper_storage_capacity where singleton for update;
 select * into j from app_private.acquisition_jobs where id=p_job_id for no key update; perform app_private.require_original_job(p_job_id);
 select * into e from app_private.execution_attempts where id=p_attempt_id and job_id=j.id and operation_id=p_claim_id;
 if e.id is null or e.generation is distinct from p_generation or e.kind not in ('original_download','original_upload','original_readback') then raise exception 'stale_execution_attempt'; end if;
 select * into r from app_private.paper_asset_reservations where id=e.reservation_id for no key update;
 select * into strict s from app_private.acquisition_steps where job_id=j.id and operation_id=p_claim_id for no key update;
 if s.result is not null then
  if s.result<>p_result then raise exception 'operation_id_conflict'; end if;
  return app_private.acquisition_job_entry(j.id);
 end if;
 perform app_private.original_current(e,j,r,a);
 if app_private.execution_unsettled(e.id) then raise exception 'execution_retirement_required'; end if;
 if e.kind='original_upload' then
  perform app_private.original_shape(p_result,array['kind','upload_ack_sha256'],4096);
  select * into strict q from app_private.execution_quiescence where attempt_id=e.id and resource='object_write';
  if p_result->>'kind' is distinct from 'original_upload_v1' or app_private.original_hash(p_result->'upload_ack_sha256') is distinct from app_private.original_hash(q.facts->'ack_sha256')
   then raise exception 'invalid_original_result'; end if;
  update app_private.paper_asset_reservations set state='pending_verification' where id=r.id;
 else
  perform app_private.original_shape(p_result,array['kind','spool_descriptor','spool_descriptor_sha256'],4096);
  if p_result->>'kind' is distinct from e.kind||'_v1' then raise exception 'invalid_original_result'; end if;
  descriptor:=p_result->'spool_descriptor';
  perform app_private.validate_original_spool(descriptor,app_private.original_hash(p_result->'spool_descriptor_sha256'),e,
   case when e.kind='original_download' then 'source_download' else 'stored_readback' end);
  select * into strict q from app_private.execution_quiescence where attempt_id=e.id and resource=case when e.kind='original_download' then 'arxiv_connection' else 'object_read' end;
  if q.evidence_kind<>'original_transfer_complete_v1' or q.facts->'status_code'<>'200'::jsonb or q.facts->'body_sha256' is distinct from descriptor->'sha256'
   or q.facts->'actual_bytes' is distinct from descriptor->'bytes' then raise exception 'original_complete_body_required'; end if;
  if e.kind='original_download' then
   if r.candidate_sha256 is not null or r.state<>'reserved' then raise exception 'invalid_original_stage'; end if;
   update app_private.paper_asset_reservations set candidate_sha256=decode(descriptor->>'sha256','hex'),candidate_bytes=(descriptor->>'bytes')::bigint where id=r.id;
  else
   if r.candidate_sha256<>decode(descriptor->>'sha256','hex') or r.candidate_bytes<>(descriptor->>'bytes')::bigint then raise exception 'original_integrity_mismatch'; end if;
   -- Only settled upload plus exact stored bytes shrinks retained capacity.
   update app_private.paper_asset_reservations set held_bytes=candidate_bytes where id=r.id;
  end if;
 end if;
 perform app_private.acquisition_finish_step(j.id,p_claim_id,p_result);
 update app_private.acquisition_jobs set stage=case e.kind when 'original_download' then 'upload' when 'original_upload' then 'readback' else 'pending_verification' end,
  status='queued',claim_id=null,lease_until=null,hard_deadline=null,error_code=null,retryable=false,state_revision=state_revision+1,next_attempt_at=clock_timestamp() where id=j.id;
 return app_private.acquisition_job_entry(j.id);
end $$;

create function app_private.original_negative(e app_private.execution_attempts,j app_private.acquisition_jobs,r app_private.paper_asset_reservations,p_result jsonb,p_error text,p_retryable boolean) returns void
language plpgsql set search_path='' as $$
declare retry boolean; pending_write boolean; p app_private.acquisition_policy;
begin
 select * into strict p from app_private.acquisition_policy;
 retry:=p_retryable and p_error in ('download_failed','rate_limited','capacity_exhausted') and e.kind in ('original_download','original_readback')
  and (select count(*) from app_private.execution_attempts where job_id=j.id and kind=e.kind)<2
  and j.created_at+make_interval(secs=>p.retry_age_seconds)>clock_timestamp() and r.expires_at>clock_timestamp();
 pending_write:=e.kind='original_upload' and app_private.execution_pending(e.id,'object_write');
 perform app_private.acquisition_finish_step(j.id,e.operation_id,p_result,case when app_private.execution_unsettled(e.id) then 'uncertain' else 'failed' end);
 update app_private.paper_asset_reservations set state=case when pending_write then 'upload_uncertain' when retry then state else 'quarantined' end,
  verification_claim=null,verification_lease_until=null where id=r.id;
 update app_private.acquisition_jobs set status=case when pending_write then 'blocked' when retry then 'retry_wait' else 'failed' end,
  error_code=p_error,retryable=retry,claim_id=null,lease_until=null,hard_deadline=null,state_revision=state_revision+1,
  next_attempt_at=clock_timestamp()+interval '30 seconds' where id=j.id;
end $$;
create function public.worker_fail_original_stage_v1(p_job_id uuid,p_claim_id uuid,p_generation bigint,p_attempt_id uuid,p_error_code text,p_retryable boolean) returns jsonb
language plpgsql security definer set search_path='' as $$
declare a app_private.executor_authority; j app_private.acquisition_jobs; r app_private.paper_asset_reservations; e app_private.execution_attempts; s app_private.acquisition_steps; result jsonb;
begin
 if current_setting('role',true) not in ('science_reader_original_executor','science_reader_pdf_verifier') then raise exception 'executor_authority_required' using errcode='42501'; end if;
 if p_error_code is null or p_error_code not in ('download_failed','pdf_invalid','verification_failed','rate_limited','capacity_exhausted')
  or p_retryable is null or p_attempt_id is null then raise exception 'invalid_acquisition_error'; end if;
 result:=jsonb_build_object('kind','original_failure_v1','attempt_id',p_attempt_id,'error_code',p_error_code,'retryable',p_retryable);
 select * into strict a from app_private.executor_authority where singleton for update;
 perform 1 from app_private.paper_storage_capacity where singleton for update;
 select * into j from app_private.acquisition_jobs where id=p_job_id for no key update; perform app_private.require_original_job(p_job_id);
 select * into e from app_private.execution_attempts where id=p_attempt_id and job_id=j.id and operation_id=p_claim_id;
 if e.id is null or e.generation is distinct from p_generation then raise exception 'stale_execution_attempt'; end if;
 perform app_private.require_executor_role(case when e.kind='original_verify' then 'science_reader_pdf_verifier' else 'science_reader_original_executor' end);
 select * into r from app_private.paper_asset_reservations where id=e.reservation_id for no key update;
 select * into strict s from app_private.acquisition_steps where job_id=j.id and operation_id=p_claim_id for no key update;
 if s.result is not null then
  if s.result<>result then raise exception 'operation_id_conflict'; end if;
  return app_private.acquisition_job_entry(j.id);
 end if;
 perform app_private.original_current(e,j,r,a);
 perform app_private.original_negative(e,j,r,result,p_error_code,p_retryable);
 return app_private.acquisition_job_entry(j.id);
end $$;
create function public.worker_expire_original_stage_v1(p_job_id uuid,p_claim_id uuid,p_generation bigint,p_attempt_id uuid) returns jsonb
language plpgsql security definer set search_path='' as $$
declare j app_private.acquisition_jobs; r app_private.paper_asset_reservations; e app_private.execution_attempts; s app_private.acquisition_steps; result jsonb; code text; retry boolean;
begin
 if current_setting('role',true) not in ('science_reader_original_executor','science_reader_pdf_verifier') then raise exception 'executor_authority_required' using errcode='42501'; end if;
 perform 1 from app_private.executor_authority where singleton for update;
 perform 1 from app_private.paper_storage_capacity where singleton for update;
 select * into j from app_private.acquisition_jobs where id=p_job_id for no key update; perform app_private.require_original_job(p_job_id);
 select * into e from app_private.execution_attempts where id=p_attempt_id and job_id=j.id and operation_id=p_claim_id;
 if e.id is null or e.generation is distinct from p_generation then raise exception 'stale_execution_attempt'; end if;
 perform app_private.require_executor_role(case when e.kind='original_verify' then 'science_reader_pdf_verifier' else 'science_reader_original_executor' end);
 select * into r from app_private.paper_asset_reservations where id=e.reservation_id for no key update;
 select * into strict s from app_private.acquisition_steps where job_id=j.id and operation_id=p_claim_id for no key update;
 if s.result is not null then return jsonb_build_object('job',app_private.acquisition_job_entry(j.id),'step_result',s.result,'replayed',true); end if;
 if j.status<>'leased' or j.claim_id is distinct from p_claim_id or j.generation is distinct from p_generation or e.report_deadline>clock_timestamp()
 then raise exception 'original_expiry_not_ready'; end if;
 code:=case when e.kind='original_verify' then 'verification_failed' else 'download_failed' end; retry:=e.kind in ('original_download','original_readback');
 result:=jsonb_build_object('kind','original_expired_v1','attempt_id',e.id,'error_code',code,'retryable',retry);
 perform app_private.original_negative(e,j,r,result,code,retry);
 return jsonb_build_object('job',app_private.acquisition_job_entry(j.id),'step_result',result,'replayed',false);
end $$;

create function public.worker_record_original_integrity_v1(p_job_id uuid,p_claim_id uuid,p_generation bigint,p_attempt_id uuid,p_result jsonb) returns jsonb
language plpgsql security definer set search_path='' as $$
declare a app_private.executor_authority; j app_private.acquisition_jobs; r app_private.paper_asset_reservations; e app_private.execution_attempts;
 s app_private.acquisition_steps; q app_private.execution_quiescence; observed bytea; observed_bytes bigint; complete boolean;
begin
 perform app_private.require_executor_role('science_reader_original_executor');
 perform app_private.original_shape(p_result,array['kind','outcome','complete_input','observed_sha256','observed_bytes'],1024);
 if p_result->>'kind' is distinct from 'original_integrity_v1' or p_result->>'outcome' is null or p_result->>'outcome' not in ('binding_mismatch','input_limit')
  or jsonb_typeof(p_result->'complete_input') is distinct from 'boolean' then raise exception 'invalid_integrity_result'; end if;
 complete:=(p_result->>'complete_input')::boolean; observed_bytes:=app_private.original_integer(p_result->'observed_bytes',0,5242881);
 if complete then observed:=app_private.original_hash(p_result->'observed_sha256'); elsif p_result->'observed_sha256' is distinct from 'null'::jsonb then raise exception 'invalid_integrity_result'; end if;
 select * into strict a from app_private.executor_authority where singleton for update;
 perform 1 from app_private.paper_storage_capacity where singleton for update;
 select * into j from app_private.acquisition_jobs where id=p_job_id for no key update; perform app_private.require_original_job(p_job_id);
 select * into e from app_private.execution_attempts where id=p_attempt_id and job_id=j.id and operation_id=p_claim_id;
 if e.id is null or e.generation is distinct from p_generation or e.kind<>'original_readback' then raise exception 'stale_execution_attempt'; end if;
 select * into r from app_private.paper_asset_reservations where id=e.reservation_id for no key update;
 select * into strict s from app_private.acquisition_steps where job_id=j.id and operation_id=p_claim_id for no key update;
 if s.result is not null then
  if s.result<>p_result then raise exception 'operation_id_conflict'; end if;
  return app_private.acquisition_job_entry(j.id);
 end if;
 perform app_private.original_current(e,j,r,a);
 if app_private.execution_unsettled(e.id) then raise exception 'execution_retirement_required'; end if;
 select * into strict q from app_private.execution_quiescence where attempt_id=e.id and resource='object_read';
 if p_result->>'outcome'='binding_mismatch' then
  if not complete or (observed,observed_bytes) is not distinct from (r.candidate_sha256,r.candidate_bytes)
   or q.evidence_kind<>'original_transfer_complete_v1' or q.facts->'status_code'<>'200'::jsonb
   or q.facts->'body_sha256' is distinct from p_result->'observed_sha256' or q.facts->'actual_bytes' is distinct from p_result->'observed_bytes'
  then raise exception 'invalid_integrity_result'; end if;
 else
  if complete or observed_bytes<>e.byte_ceiling+1 or q.evidence_kind<>'owned_scope_retired_v1' then raise exception 'invalid_integrity_result'; end if;
 end if;
 insert into app_private.paper_integrity_failures(id,reservation_id,operation_id,request_sha256,generation,profile_id,expected_sha256,expected_bytes,
  outcome,complete_input,observed_sha256,observed_bytes)
 values(gen_random_uuid(),r.id,p_claim_id,sha256(convert_to(p_result::text,'UTF8')),p_generation,r.verification_profile_id,r.candidate_sha256,r.candidate_bytes,
  p_result->>'outcome',complete,observed,observed_bytes);
 perform app_private.acquisition_finish_step(j.id,p_claim_id,p_result,'failed');
 update app_private.paper_asset_reservations set state='quarantined',held_bytes=max_bytes where id=r.id;
 update app_private.acquisition_jobs set status='failed',error_code='verification_failed',retryable=false,state_revision=state_revision+1,
  claim_id=null,lease_until=null,hard_deadline=null where id=j.id;
 perform app_private.original_envelope(j.id);
 return app_private.acquisition_job_entry(j.id);
end $$;

create function public.worker_finish_original_verification_v1(p_job_id uuid,p_claim_id uuid,p_generation bigint,p_attempt_id uuid,p_verification_generation bigint,p_result jsonb) returns jsonb
language plpgsql security definer set search_path='' as $$
declare a app_private.executor_authority; j app_private.acquisition_jobs; r app_private.paper_asset_reservations; e app_private.execution_attempts; s app_private.acquisition_steps;
 v app_private.paper_verification_profiles; ep app_private.executor_policies; m jsonb; h jsonb; page integer; outcome text; result_id uuid; k text;
begin
 perform app_private.require_executor_role('science_reader_pdf_verifier');
 perform app_private.original_shape(p_result,array['kind','outcome','profile_id','build_sha256','parser_profile_sha256','sha256','byte_count','page_count','metrics','host_evidence'],4096);
 outcome:=p_result->>'outcome';
 if p_result->>'kind' is distinct from 'original_verification_v1' or outcome is null
  or outcome not in ('verified','malformed','encrypted','unsupported','parser_resource_limit','input_limit','page_limit','resource_limit','time_limit','internal_error') then raise exception 'invalid_verification_result'; end if;
 select * into strict a from app_private.executor_authority where singleton for update;
 perform 1 from app_private.paper_storage_capacity where singleton for update;
 select * into j from app_private.acquisition_jobs where id=p_job_id for no key update; perform app_private.require_original_job(p_job_id);
 select * into e from app_private.execution_attempts where id=p_attempt_id and job_id=j.id and operation_id=p_claim_id;
 if e.id is null or e.generation is distinct from p_generation or e.kind<>'original_verify' or e.verification_generation is distinct from p_verification_generation then raise exception 'stale_execution_attempt'; end if;
 select * into r from app_private.paper_asset_reservations where id=e.reservation_id for no key update;
 select * into strict s from app_private.acquisition_steps where job_id=j.id and operation_id=p_claim_id for no key update;
 if s.result is not null then
  if s.result<>p_result then raise exception 'operation_id_conflict'; end if;
  return jsonb_build_object('job',app_private.acquisition_job_entry(j.id),'result_id',r.verification_result_id,'replayed',true);
 end if;
 perform app_private.original_current(e,j,r,a);
 if app_private.execution_unsettled(e.id) then raise exception 'execution_retirement_required'; end if;
 select * into strict v from app_private.paper_verification_profiles where id=r.verification_profile_id;
 select * into strict ep from app_private.executor_policies where id=e.policy_id;
 if r.state<>'verifying' or r.verification_claim is distinct from p_claim_id or r.verification_generation is distinct from p_verification_generation
  or app_private.original_uuid(p_result->'profile_id')<>v.id or app_private.original_hash(p_result->'build_sha256')<>v.build_sha256
  or p_result->'parser_profile_sha256' is distinct from v.definition->'parser_profile_sha256'
  or app_private.original_hash(p_result->'sha256')<>r.candidate_sha256 or app_private.original_integer(p_result->'byte_count',1,v.max_bytes)<>r.candidate_bytes
  or e.input_spool_sha256 is null then raise exception 'invalid_verification_binding'; end if;
 if outcome='verified' then page:=app_private.original_integer(p_result->'page_count',1,v.max_pages);
 elsif p_result->'page_count' is distinct from 'null'::jsonb then raise exception 'invalid_verification_result'; end if;
 m:=p_result->'metrics'; h:=p_result->'host_evidence';
 perform app_private.original_shape(m,array['cpu_ms','wall_ms','peak_host_bytes','wasm_bytes','warnings','repaired'],1024);
 perform app_private.original_shape(h,array['kind','host_policy_sha256','measurement','evidence_sha256'],1024);
 if h->>'kind' is distinct from 'synthetic-sql-fixture' or h->>'measurement' is distinct from 'owned-process-rss-upper-envelope-v1'
  or h->'host_policy_sha256' is distinct from ep.definition->'verifier_host_policy_sha256'
  or v.definition->'local_fixture_only' is distinct from 'true'::jsonb then raise exception 'invalid_original_host_evidence'; end if;
 perform app_private.original_hash(h->'evidence_sha256');
 -- Finite integers on negative reports too; only positive reports must fit the
 -- profile. The evidence kind remains explicitly synthetic on every outcome.
 perform app_private.original_integer(m->'cpu_ms',0,2147483647); perform app_private.original_integer(m->'wall_ms',0,2147483647);
 perform app_private.original_integer(m->'peak_host_bytes',1,9223372036854775807); perform app_private.original_integer(m->'wasm_bytes',1,9223372036854775807);
 perform app_private.original_integer(m->'warnings',0,2147483647);
 if jsonb_typeof(m->'repaired') is distinct from 'boolean' then raise exception 'invalid_verification_result'; end if;
 if outcome='verified' and ((m->>'cpu_ms')::bigint>v.cpu_ms or (m->>'wall_ms')::bigint>v.wall_ms
  or (m->>'wall_ms')::bigint>extract(epoch from(e.useful_deadline-e.created_at))*1000
  or (m->>'peak_host_bytes')::bigint>v.host_memory_bytes or (m->>'wasm_bytes')::bigint>v.wasm_memory_bytes
  or m->'warnings'<>'0'::jsonb or m->'repaired'<>'false'::jsonb) then raise exception 'verification_profile_limit'; end if;
 result_id:=gen_random_uuid();
 insert into app_private.paper_verification_results(id,reservation_id,generation,profile_id,operation_id,request_sha256,sha256,byte_count,page_count,outcome,verifier_identity,metrics)
 values(result_id,r.id,p_verification_generation,v.id,p_claim_id,sha256(convert_to(p_result::text,'UTF8')),r.candidate_sha256,r.candidate_bytes,page,outcome,v.verifier_identity,
  m);
 update app_private.paper_asset_reservations set verification_result_id=result_id,verification_claim=null,verification_lease_until=null,
  state=case when outcome='verified' then 'verified' else 'quarantined' end where id=r.id;
 perform app_private.acquisition_finish_step(j.id,p_claim_id,p_result,case when outcome='verified' then 'complete' else 'failed' end);
 update app_private.acquisition_jobs set stage=case when outcome='verified' then 'publish' else stage end,status=case when outcome='verified' then 'queued' else 'failed' end,
  error_code=case when outcome<>'verified' then 'verification_failed' end,retryable=false,state_revision=state_revision+1,
  claim_id=null,lease_until=null,hard_deadline=null,next_attempt_at=clock_timestamp() where id=j.id;
 perform app_private.original_envelope(j.id);
 return jsonb_build_object('job',app_private.acquisition_job_entry(j.id),'result_id',result_id,'replayed',false);
end $$;

create function public.worker_publish_original_v1(p_job_id uuid,p_operation_id uuid,p_reservation_id uuid,p_expected_verification_result_id uuid) returns jsonb
language plpgsql security definer set search_path='' as $$
declare a app_private.executor_authority; j app_private.acquisition_jobs; r app_private.paper_asset_reservations;
 v app_private.paper_verification_results; s app_private.acquisition_steps; p app_private.acquisition_policy; digest bytea; result jsonb;
begin
 perform app_private.require_executor_role('science_reader_original_executor');
 if p_job_id is null or p_operation_id is null or p_reservation_id is null or p_expected_verification_result_id is null then raise exception 'invalid_original_publication'; end if;
 digest:=sha256(convert_to(jsonb_build_array('original-publish-v1',p_job_id,p_operation_id,p_reservation_id,p_expected_verification_result_id)::text,'UTF8'));
 select * into strict a from app_private.executor_authority where singleton for update;
 perform 1 from app_private.paper_storage_capacity where singleton for update;
 select * into r from app_private.paper_asset_reservations where id=p_reservation_id and job_id=p_job_id;
 select * into v from app_private.paper_verification_results where id=p_expected_verification_result_id and reservation_id=p_reservation_id and outcome='verified';
 if r.id is null or v.id is null or r.verification_result_id is distinct from v.id then raise exception 'original_verification_required'; end if;
 -- Include implied document FK locks before job/reservation and catalog policy.
 perform 1 from app_private.documents where scope='shared_catalog' and sha256=v.sha256 for update;
 select * into j from app_private.acquisition_jobs where id=p_job_id for no key update; perform app_private.require_original_job(p_job_id);
 select * into r from app_private.paper_asset_reservations where id=p_reservation_id for no key update;
 select * into s from app_private.acquisition_steps where job_id=j.id and operation_id=p_operation_id;
 if found then
  if s.kind<>'original_publish_v1' or s.request_sha256<>digest or s.result is null then raise exception 'operation_id_conflict'; end if;
  return app_private.acquisition_job_entry(j.id);
 end if;
 select * into strict p from app_private.acquisition_policy;
 if not a.enabled or not a.original_admitted or a.recovery_required or not p.original_enabled or not p.verification_enabled
  or p.active_verification_profile is distinct from r.verification_profile_id
  or (a.original_policy_id,a.original_deployment_id,a.admitted_host_id,a.admitted_boot_id)
   is distinct from (j.original_policy_id,j.original_deployment_id,j.original_host_id,j.original_boot_id) then raise exception 'original_acquisition_disabled'; end if;
 if j.stage<>'publish' or j.status<>'queued' or r.state<>'verified' or r.expires_at<=clock_timestamp()
  or exists(select 1 from app_private.execution_attempts x where x.job_id=j.id and app_private.execution_unsettled(x.id))
  or not exists(select 1 from app_private.execution_attempts x join app_private.acquisition_steps t on(t.job_id,t.operation_id)=(x.job_id,x.operation_id)
   where x.job_id=j.id and x.kind='original_verify' and t.result->>'outcome'='verified' and t.operation_id=v.operation_id
    and x.verification_generation=v.generation and x.input_spool_sha256 is not null)
 then raise exception 'original_publication_not_ready'; end if;
 insert into app_private.acquisition_steps(job_id,operation_id,request_sha256,kind,generation,stage)
 values(j.id,p_operation_id,digest,'original_publish_v1',j.generation+1,'publish');
 update app_private.acquisition_jobs set generation=generation+1,status='leased',claim_id=p_operation_id,lease_until=clock_timestamp()+interval '120 seconds'
  where id=j.id;
 -- The 011 publisher remains revoked; only this fenced path can invoke its
 -- exact-hash document, verified-object, approval and outbox transaction.
 result:=public.worker_publish_original(j.id,p_operation_id,j.generation+1,r.id);
 perform app_private.original_envelope(j.id);
 return result;
end $$;
create function public.worker_bind_lookup_original_v1(p_lookup_job_id uuid,p_original_job_id uuid) returns jsonb
language plpgsql security definer set search_path='' as $$
begin
 perform app_private.require_executor_role('science_reader_original_executor');
 perform app_private.require_original_job(p_original_job_id);
 return public.worker_bind_lookup_original(p_lookup_job_id,p_original_job_id);
end $$;
create function public.worker_scan_original_jobs_v1(p_after_job_id uuid default null,p_limit integer default 50) returns jsonb
language plpgsql stable security definer set search_path='' as $$
begin
 if current_setting('role',true) not in ('science_reader_original_executor','science_reader_pdf_verifier') then raise exception 'executor_authority_required' using errcode='42501'; end if;
 if p_limit is null or p_limit not between 1 and 100 then raise exception 'invalid_executor_scan'; end if;
 return (select coalesce(jsonb_agg(jsonb_build_object('id',id,'stage',stage,'status',status,'state_revision',state_revision) order by id),'[]'::jsonb)
  from (select id,stage,status,state_revision from app_private.acquisition_jobs
   where execution_contract='original-v1' and (p_after_job_id is null or id>p_after_job_id)
   and status in ('queued','retry_wait','leased','blocked')
   and (current_setting('role',true)<>'science_reader_pdf_verifier' or stage='pending_verification')
   order by id limit p_limit) s);
end $$;
create function public.worker_scan_unsettled_executions(p_after_attempt_id uuid default null,p_limit integer default 50) returns jsonb
language plpgsql stable security definer set search_path='' as $$
begin
 if current_setting('role',true) not in ('science_reader_original_executor','science_reader_pdf_verifier','science_reader_execution_observer','science_reader_executor_admitter')
 then raise exception 'executor_authority_required' using errcode='42501'; end if;
 if p_limit is null or p_limit not between 1 and 100 then raise exception 'invalid_executor_scan'; end if;
 return (select coalesce(jsonb_agg(app_private.execution_entry(id) order by id),'[]'::jsonb) from
  (select id from app_private.execution_attempts where (p_after_attempt_id is null or id>p_after_attempt_id) and app_private.execution_unsettled(id)
   and (current_setting('role',true) not in ('science_reader_original_executor','science_reader_pdf_verifier') or kind like 'original_%')
   and (current_setting('role',true)<>'science_reader_pdf_verifier' or kind='original_verify') order by id limit p_limit) s);
end $$;

-- Keep all old public signatures and metadata behavior. A small public guard
-- runs BEFORE their replay branches; the unmodified 012 bodies become private
-- implementations, callable only by the definer. No old original RPC is moved.
create function app_private.require_metadata_job(p_id uuid) returns void language plpgsql stable security definer set search_path='' as $$
begin
 if not exists(select 1 from app_private.acquisition_jobs where id=p_id and execution_contract='metadata-v2' and kind='lookup')
 then raise exception 'metadata_execution_contract_required'; end if;
end $$;
alter function public.worker_claim_metadata_stage_v2(uuid,uuid,text,jsonb) set schema app_private;
create function public.worker_claim_metadata_stage_v2(p_job_id uuid,p_claim_id uuid,p_environment text,p_executor_binding jsonb) returns jsonb
language plpgsql security definer set search_path='' as $$
begin
 perform app_private.require_executor_role('science_reader_metadata_executor'); perform app_private.require_metadata_job(p_job_id);
 return app_private.worker_claim_metadata_stage_v2(p_job_id,p_claim_id,p_environment,p_executor_binding);
end $$;
alter function public.worker_finish_metadata_stage_v2(uuid,uuid,bigint,uuid,bytea,jsonb) set schema app_private;
create function public.worker_finish_metadata_stage_v2(p_job_id uuid,p_claim_id uuid,p_generation bigint,p_attempt_id uuid,p_body_sha256 bytea,p_result jsonb) returns jsonb
language plpgsql security definer set search_path='' as $$
begin
 perform app_private.require_executor_role('science_reader_metadata_executor'); perform app_private.require_metadata_job(p_job_id);
 return app_private.worker_finish_metadata_stage_v2(p_job_id,p_claim_id,p_generation,p_attempt_id,p_body_sha256,p_result);
end $$;
alter function public.worker_fail_metadata_stage_v2(uuid,uuid,bigint,uuid,text,boolean) set schema app_private;
create function public.worker_fail_metadata_stage_v2(p_job_id uuid,p_claim_id uuid,p_generation bigint,p_attempt_id uuid,p_error_code text,p_retryable boolean) returns jsonb
language plpgsql security definer set search_path='' as $$
begin
 perform app_private.require_executor_role('science_reader_metadata_executor'); perform app_private.require_metadata_job(p_job_id);
 return app_private.worker_fail_metadata_stage_v2(p_job_id,p_claim_id,p_generation,p_attempt_id,p_error_code,p_retryable);
end $$;
alter function public.worker_record_metadata_quiescence(uuid,uuid,text,text,jsonb) set schema app_private;
create function public.worker_record_metadata_quiescence(p_attempt_id uuid,p_receipt_id uuid,p_resource text,p_evidence_kind text,p_facts jsonb) returns jsonb
language plpgsql security definer set search_path='' as $$
declare e app_private.execution_attempts;
begin
 perform app_private.require_executor_role('science_reader_execution_observer');
 select * into e from app_private.execution_attempts where id=p_attempt_id;
 if not found then raise exception 'execution_unavailable'; end if;
 perform app_private.require_metadata_job(e.job_id);
 if e.kind not in ('atom','license') then raise exception 'metadata_execution_contract_required'; end if;
 return app_private.worker_record_metadata_quiescence(p_attempt_id,p_receipt_id,p_resource,p_evidence_kind,p_facts);
end $$;
create or replace function public.worker_metadata_execution_state(p_job_id uuid,p_claim_id uuid) returns jsonb
language plpgsql stable security definer set search_path='' as $$
begin
 if current_setting('role',true) not in ('science_reader_metadata_executor','science_reader_execution_observer') then raise exception 'executor_authority_required' using errcode='42501'; end if;
 if p_job_id is null or p_claim_id is null then raise exception 'invalid_acquisition_claim'; end if;
 perform app_private.require_metadata_job(p_job_id);
 return jsonb_build_object('job',app_private.acquisition_job_entry(p_job_id),
  'execution',(select app_private.execution_entry(id) from app_private.execution_attempts where job_id=p_job_id and operation_id=p_claim_id and kind in ('atom','license')),
  'step_result',(select result from app_private.acquisition_steps where job_id=p_job_id and operation_id=p_claim_id));
end $$;
create or replace function public.worker_scan_unsettled_metadata_executions(p_after_attempt_id uuid default null,p_limit integer default 50) returns jsonb
language plpgsql stable security definer set search_path='' as $$
begin
 if current_setting('role',true) not in ('science_reader_metadata_executor','science_reader_execution_observer','science_reader_executor_admitter') then raise exception 'executor_authority_required' using errcode='42501'; end if;
 if p_limit is null or p_limit not between 1 and 100 then raise exception 'invalid_executor_scan'; end if;
 return (select coalesce(jsonb_agg(app_private.execution_entry(id) order by id),'[]'::jsonb) from
  (select e.id from app_private.execution_attempts e join app_private.acquisition_jobs j on j.id=e.job_id
   where j.execution_contract='metadata-v2' and e.kind in ('atom','license') and (p_after_attempt_id is null or e.id>p_after_attempt_id)
   and app_private.execution_unsettled(e.id) order by e.id limit p_limit) s);
end $$;

create or replace function public.worker_retire_metadata_executor(p_expected_revision bigint) returns jsonb
language plpgsql security definer set search_path='' as $$
declare a app_private.executor_authority;
begin
 perform app_private.require_executor_role('science_reader_executor_admitter');
 select * into strict a from app_private.executor_authority where singleton for update;
 if p_expected_revision is distinct from a.revision then raise exception 'stale_executor_authority'; end if;
 update app_private.executor_authority set enabled=false,original_admitted=false,recovery_required=true,revision=revision+1 where singleton;
 update app_private.acquisition_policy set metadata_enabled=false,original_enabled=false,verification_enabled=false where singleton;
 return public.worker_metadata_authority_state();
end $$;
alter function public.worker_activate_metadata_executor(bigint,text,uuid,bytea) set schema app_private;
create function public.worker_activate_metadata_executor(p_expected_revision bigint,p_project_ref text,p_policy_id uuid,p_recovery_evidence_sha256 bytea) returns jsonb
language plpgsql security definer set search_path='' as $$
declare a app_private.executor_authority;
begin
 perform app_private.require_executor_role('science_reader_executor_admitter');
 select * into strict a from app_private.executor_authority where singleton for update;
 if p_expected_revision is distinct from a.revision then raise exception 'stale_executor_authority'; end if;
 if exists(select 1 from app_private.execution_attempts e where app_private.execution_unsettled(e.id)) then raise exception 'executor_recovery_required'; end if;
 if exists(select 1 from app_private.executor_authority where original_policy_id is not null) then raise exception 'original_activation_required'; end if;
 return app_private.worker_activate_metadata_executor(p_expected_revision,p_project_ref,p_policy_id,p_recovery_evidence_sha256);
end $$;
alter function public.worker_activate_metadata_executor_v2(bigint,text,uuid,uuid,uuid,text,bytea) set schema app_private;
create function public.worker_activate_metadata_executor_v2(p_expected_revision bigint,p_project_ref text,p_policy_id uuid,p_host_id uuid,p_boot_id uuid,p_deployment_id text,p_recovery_evidence_sha256 bytea) returns jsonb
language plpgsql security definer set search_path='' as $$
declare a app_private.executor_authority;
begin
 perform app_private.require_executor_role('science_reader_executor_admitter');
 select * into strict a from app_private.executor_authority where singleton for update;
 if p_expected_revision is distinct from a.revision then raise exception 'stale_executor_authority'; end if;
 if exists(select 1 from app_private.execution_attempts e where app_private.execution_unsettled(e.id)) then raise exception 'executor_recovery_required'; end if;
 if exists(select 1 from app_private.executor_authority where original_policy_id is not null) then raise exception 'original_activation_required'; end if;
 return app_private.worker_activate_metadata_executor_v2(p_expected_revision,p_project_ref,p_policy_id,p_host_id,p_boot_id,p_deployment_id,p_recovery_evidence_sha256);
end $$;

-- Role-specific, explicit grants; the migration creates no login, secret,
-- enabled profile/policy, Storage authority or reader descriptor permission.
do $$ declare f record; r text; allowed text[]; begin
 for f in select oid::regprocedure as sig from pg_proc where pronamespace='app_private'::regnamespace loop
  execute format('revoke all on function %s from public,anon,authenticated,service_role,science_reader_pdf_verifier,science_reader_metadata_executor,science_reader_original_executor,science_reader_execution_observer,science_reader_executor_admitter',f.sig);
 end loop;
 for f in select c.oid::regclass as rel from pg_class c where c.relnamespace='app_private'::regnamespace and c.relkind in ('r','p','S') loop
  execute format('revoke all on %s from science_reader_original_executor',f.rel);
 end loop;
 for f in select oid::regprocedure as sig from pg_proc where pronamespace='public'::regnamespace and proname in (
  'worker_install_original_verification_profile_v1','worker_install_original_executor_policy_v1','worker_original_authority_state','worker_activate_original_executor_v1',
  'worker_prepare_original_v1','worker_reserve_original_v1','worker_claim_original_stage_v1','worker_finish_original_stage_v1','worker_fail_original_stage_v1',
  'worker_expire_original_stage_v1','worker_record_original_integrity_v1','worker_finish_original_verification_v1','worker_publish_original_v1','worker_bind_lookup_original_v1',
  'worker_original_job_state','worker_original_execution_state','worker_scan_original_jobs_v1','worker_scan_unsettled_executions','worker_record_original_quiescence',
  'worker_claim_metadata_stage_v2','worker_finish_metadata_stage_v2','worker_fail_metadata_stage_v2','worker_record_metadata_quiescence',
  'worker_activate_metadata_executor','worker_activate_metadata_executor_v2') loop
  execute format('revoke all on function %s from public,anon,authenticated,service_role,science_reader_pdf_verifier,science_reader_metadata_executor,science_reader_original_executor,science_reader_execution_observer,science_reader_executor_admitter',f.sig);
 end loop;
 foreach r in array array['science_reader_original_executor','science_reader_pdf_verifier','science_reader_metadata_executor','science_reader_execution_observer','science_reader_executor_admitter'] loop
  allowed:=case r
   when 'science_reader_original_executor' then array['worker_prepare_original_v1','worker_reserve_original_v1','worker_claim_original_stage_v1','worker_finish_original_stage_v1',
    'worker_fail_original_stage_v1','worker_expire_original_stage_v1','worker_record_original_integrity_v1','worker_publish_original_v1','worker_bind_lookup_original_v1',
    'worker_original_authority_state','worker_original_job_state','worker_original_execution_state','worker_scan_original_jobs_v1','worker_scan_unsettled_executions',
    'worker_import_state','worker_link_import_acquisition','worker_project_import_acquisition','worker_scan_acquisition_imports']
   when 'science_reader_pdf_verifier' then array['worker_claim_original_stage_v1','worker_fail_original_stage_v1','worker_expire_original_stage_v1','worker_finish_original_verification_v1',
    'worker_original_authority_state','worker_original_job_state','worker_original_execution_state','worker_scan_original_jobs_v1','worker_scan_unsettled_executions']
   when 'science_reader_metadata_executor' then array['worker_claim_metadata_stage_v2','worker_finish_metadata_stage_v2','worker_fail_metadata_stage_v2']
   when 'science_reader_execution_observer' then array['worker_record_metadata_quiescence','worker_record_original_quiescence','worker_original_authority_state',
    'worker_original_job_state','worker_original_execution_state','worker_scan_unsettled_executions']
   else array['worker_install_original_verification_profile_v1','worker_install_original_executor_policy_v1','worker_original_authority_state','worker_activate_original_executor_v1',
    'worker_original_job_state','worker_original_execution_state','worker_scan_unsettled_executions','worker_activate_metadata_executor','worker_activate_metadata_executor_v2'] end;
  for f in select oid::regprocedure as sig from pg_proc where pronamespace='public'::regnamespace and proname=any(allowed) loop
   execute format('grant execute on function %s to %I',f.sig,r);
  end loop;
 end loop;
end $$;
commit;
