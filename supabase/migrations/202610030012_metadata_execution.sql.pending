-- Local review candidate. Metadata-only executor settlement; no credentials,
-- policies, admission, scheduler, or network adapter are installed here.
-- Applied 001--011 bytes are unchanged. All new operational authority is off.
begin;

-- DDL barriers fence old transactions before accounting/admission is changed.
lock table app_private.acquisition_policy, app_private.arxiv_network_gate,
 app_private.acquisition_source_slots, app_private.acquisition_jobs, app_private.acquisition_steps in access exclusive mode;
do $$ begin
 if exists(select 1 from app_private.acquisition_policy where metadata_enabled or original_enabled or verification_enabled)
  or exists(select 1 from app_private.paper_read_policy where enabled) then
  raise exception 'executor_migration_requires_disabled_workers';
 end if;
 if (select (count(*)+coalesce(sum(slots_held),0)) from app_private.acquisition_jobs)
   +(select count(*) from app_private.acquisition_commands)
   +(select count(*) from app_private.acquisition_source_slots)
   +2*(select count(*) from app_private.paper_verification_profiles)+32
   >(select control_bytes/8192 from app_private.acquisition_policy) then
  raise exception 'executor_migration_control_capacity';
 end if;
end $$;

do $$ declare n text; begin
 foreach n in array array['science_reader_metadata_executor','science_reader_execution_observer','science_reader_executor_admitter'] loop
  if not exists(select 1 from pg_roles where rolname=n) then
   execute format('create role %I nologin noinherit nosuperuser nocreatedb nocreaterole noreplication nobypassrls',n);
  elsif exists(select 1 from pg_roles where rolname=n and (rolcanlogin or rolsuper or rolcreatedb or rolcreaterole or rolreplication or rolbypassrls or rolinherit)) then
   raise exception 'executor_role_configuration_conflict';
  end if;
  -- The migration never grants membership, creates a login, or supplies a secret.
  if exists(select 1 from pg_auth_members m join pg_roles r on r.oid=m.roleid where r.rolname=n
   and not (m.member=(select datdba from pg_database where datname=current_database())
    and m.member=(select oid from pg_roles where rolname=current_user) and m.admin_option and not m.inherit_option and not m.set_option))
   or exists(select 1 from pg_auth_members m join pg_roles r on r.oid=m.member where r.rolname=n) then
   raise exception 'executor_role_membership_requires_review';
  end if;
  execute format('grant usage on schema public to %I',n);
 end loop;
end $$;

alter table app_private.acquisition_jobs add column execution_contract text not null default 'legacy-011'
 check(execution_contract in ('legacy-011','metadata-v2'));
alter table app_private.acquisition_jobs add constraint metadata_execution_envelope
 check(execution_contract<>'metadata-v2' or (kind='lookup' and slots_held=24));
create function app_private.protect_execution_job_contract() returns trigger language plpgsql set search_path='' as $$
begin
 if new.execution_contract is distinct from old.execution_contract then raise exception 'immutable_execution_contract'; end if;
 return new;
end $$;
create trigger acquisition_execution_contract before update on app_private.acquisition_jobs
 for each row execute function app_private.protect_execution_job_contract();

-- Shared identity family, intentionally restricted to metadata in this version.
create table app_private.executor_policies (
 id uuid primary key, policy_sha256 bytea not null unique check(octet_length(policy_sha256)=32),
 canonical_policy text not null check(octet_length(canonical_policy)<=8192),
 definition jsonb not null check(jsonb_typeof(definition)='object' and canonical_policy::jsonb=definition
  and policy_sha256=sha256(convert_to(canonical_policy,'UTF8'))),
 kind text not null check(kind='metadata-owned-child-v1'),
 runner_sha256 bytea not null check(octet_length(runner_sha256)=32),
 transport_sha256 bytea not null check(octet_length(transport_sha256)=32),
 observer_sha256 bytea not null check(octet_length(observer_sha256)=32),
 admission_sha256 bytea not null check(octet_length(admission_sha256)=32),
 useful_seconds integer not null check(useful_seconds between 1 and 120),
 report_seconds integer not null check(report_seconds between useful_seconds and 120),
 created_at timestamptz not null default clock_timestamp()
);
create trigger executor_policy_immutable before update or delete on app_private.executor_policies
 for each row execute function app_private.immutable_record();
create table app_private.executor_authority (
 singleton boolean primary key default true check(singleton),
 revision bigint not null default 1 check(revision>0),
 project_ref text check(project_ref ~ '^[a-z]{20}$'), environment text not null default 'staging' check(environment='staging'),
 epoch uuid not null default gen_random_uuid(), enabled boolean not null default false,
 recovery_required boolean not null default true,
 active_policy_id uuid references app_private.executor_policies(id),
 max_executors integer not null default 1 check(max_executors=1),
 recovery_evidence_sha256 bytea check(recovery_evidence_sha256 is null or octet_length(recovery_evidence_sha256)=32),
 check(not enabled or (not recovery_required and project_ref is not null and active_policy_id is not null))
);
insert into app_private.executor_authority(singleton) values(true);
create table app_private.execution_attempts (
 id uuid primary key, job_id uuid not null, operation_id uuid not null,
 generation bigint not null check(generation>0), kind text not null check(kind in ('atom','license')),
 request_sha256 bytea not null check(octet_length(request_sha256)=32),
 epoch uuid not null, policy_id uuid not null references app_private.executor_policies(id),
 project_ref text not null check(project_ref ~ '^[a-z]{20}$'), environment text not null check(environment='staging'),
 binding jsonb not null check(jsonb_typeof(binding)='object' and octet_length(binding::text)<=2048),
 binding_sha256 bytea not null check(binding_sha256=sha256(convert_to(binding::text,'UTF8'))),
 host_id uuid not null, boot_id uuid not null, process_id bigint not null check(process_id between 1 and 2147483647),
 process_start_id text not null check(process_start_id ~ '^[0-9]{1,20}$'), child_id uuid not null unique,
 useful_deadline timestamptz not null, report_deadline timestamptz not null,
 byte_ceiling bigint not null check(byte_ceiling=1048576), charge_period date not null,
 created_at timestamptz not null default clock_timestamp(),
 unique(job_id,operation_id), unique(host_id,boot_id,process_id,process_start_id),
 foreign key(job_id,operation_id) references app_private.acquisition_steps(job_id,operation_id),
 check(useful_deadline>created_at and report_deadline>=useful_deadline and report_deadline<=created_at+interval '120 seconds')
);
create trigger execution_attempt_immutable before update or delete on app_private.execution_attempts
 for each row execute function app_private.immutable_record();
create table app_private.execution_quiescence (
 attempt_id uuid not null references app_private.execution_attempts(id),
 resource text not null check(resource in ('executor','arxiv_connection')),
 receipt_id uuid not null unique, request_sha256 bytea not null check(octet_length(request_sha256)=32),
 evidence_kind text not null check(evidence_kind='owned_child_joined'),
 facts jsonb not null check(jsonb_typeof(facts)='object' and octet_length(facts::text)<=2048),
 accepted_at timestamptz not null default clock_timestamp(),
 primary key(attempt_id,resource)
);
create trigger execution_quiescence_immutable before update or delete on app_private.execution_quiescence
 for each row execute function app_private.immutable_record();

create function app_private.require_executor_role(p_role text) returns void language plpgsql set search_path='' as $$
begin
 if current_setting('role',true) is distinct from p_role then raise exception 'executor_authority_required' using errcode='42501'; end if;
end $$;
create function app_private.legacy_execution_unsettled() returns boolean language sql stable security definer set search_path='' as $$
 select exists(select 1 from app_private.acquisition_steps s join app_private.acquisition_jobs j on j.id=s.job_id
   where j.execution_contract='legacy-011' and s.network_token is not null)
 or exists(select 1 from app_private.arxiv_network_gate g left join app_private.execution_attempts e on e.id=g.token
   where g.token is not null and e.id is null)
 or exists(select 1 from app_private.paper_asset_reservations)
 or exists(select 1 from app_private.paper_read_grants)
$$;
create function app_private.execution_pending(p_id uuid,p_resource text) returns boolean language sql stable security definer set search_path='' as $$
 select not exists(select 1 from app_private.execution_quiescence where attempt_id=p_id and resource=p_resource)
$$;
create function app_private.execution_entry(p_id uuid) returns jsonb language sql stable security definer set search_path='' as $$
 select jsonb_build_object('id',e.id,'job_id',e.job_id,'claim_id',e.operation_id,'generation',e.generation,'kind',e.kind,
  'epoch',e.epoch,'policy_id',e.policy_id,'binding',e.binding,'binding_sha256',encode(e.binding_sha256,'hex'),
  'created_at',e.created_at,'useful_deadline',e.useful_deadline,'report_deadline',e.report_deadline,'byte_ceiling',e.byte_ceiling,
  'pending_resources',(select coalesce(jsonb_agg(r order by r),'[]'::jsonb) from unnest(array['executor','arxiv_connection']) r where app_private.execution_pending(e.id,r)),
  'receipts',(select coalesce(jsonb_agg(jsonb_build_object('resource',q.resource,'receipt_id',q.receipt_id,'evidence_kind',q.evidence_kind,'facts',q.facts,'accepted_at',q.accepted_at) order by q.resource),'[]'::jsonb)
   from app_private.execution_quiescence q where q.attempt_id=e.id)) from app_private.execution_attempts e where e.id=p_id
$$;

-- Prepay every future step/execution/receipt at preparation. No grant acquires
-- acquisition_policy after a job lock. 32 fixed units reserve authority/policy
-- storage, and source-slot rows are now included in the conservative envelope.
create or replace function app_private.acquisition_admit(p_slots integer,p_new_slot boolean) returns void language plpgsql security definer set search_path='' as $$
declare p app_private.acquisition_policy; n bigint; held bigint; commands bigint; sources bigint;
begin
 select * into strict p from app_private.acquisition_policy where singleton for update;
 select count(*),coalesce(sum(slots_held),0) into n,held from app_private.acquisition_jobs;
 select count(*) into commands from app_private.acquisition_commands;
 select count(*) into sources from app_private.acquisition_source_slots;
 if n+(case when p_slots>0 then 1 else 0 end)>p.jobs or held+p_slots+commands+1>p.steps
 or (32+n+(case when p_slots>0 then 1 else 0 end)+held+p_slots+commands+1+sources+(case when p_new_slot then 1 else 0 end)
  +2*(select count(*) from app_private.paper_verification_profiles))*8192>p.control_bytes then raise exception 'acquisition_control_capacity'; end if;
 if p_new_slot and sources+1>p.source_slots then raise exception 'acquisition_source_capacity'; end if;
end $$;

create or replace function public.worker_prepare_acquisition(p_operation_id uuid,p_source_id text,p_requested_revision integer default null) returns jsonb
language plpgsql security definer set search_path='' as $$
declare src text:=app_private.validate_arxiv_id(p_source_id); digest bytea; command app_private.acquisition_commands;
 slot app_private.acquisition_source_slots; j app_private.acquisition_jobs; p app_private.acquisition_policy; chosen uuid;
begin
 if p_operation_id is null or (p_requested_revision is not null and p_requested_revision<1) then raise exception 'invalid_acquisition_request'; end if;
 digest:=sha256(convert_to(jsonb_build_array('lookup',src,p_requested_revision)::text,'UTF8'));
 select * into strict p from app_private.acquisition_policy where singleton for update;
 select * into command from app_private.acquisition_commands where id=p_operation_id;
 if found then
  if command.request_sha256<>digest then raise exception 'operation_id_conflict'; end if;
  return jsonb_build_object('job',app_private.acquisition_job_entry(command.job_id),'replayed',true);
 end if;
 select * into slot from app_private.acquisition_source_slots where source_id=src and requested_revision=coalesce(p_requested_revision,0) for no key update;
 if found then
  select * into j from app_private.acquisition_jobs where id=slot.active_job_id for no key update;
  if j.status in ('queued','leased','retry_wait','blocked') and j.execution_contract='metadata-v2' and j.created_at+make_interval(secs=>p.retry_age_seconds)>clock_timestamp() then chosen:=j.id;
  elsif slot.cached_job_id is not null and slot.fresh_until>clock_timestamp() then chosen:=slot.cached_job_id;
  end if;
 end if;
 if chosen is not null then
  perform app_private.acquisition_admit(0,false);
 else
  perform app_private.acquisition_admit(24,slot.id is null);
  if slot.id is null then
   insert into app_private.acquisition_source_slots(source_id,requested_revision) values(src,coalesce(p_requested_revision,0)) returning * into slot;
  end if;
  -- Retire expired unclaimed work before installing a new generation. A late
  -- claim/output is fenced by status/generation and cannot repin its successor.
  if j.id is not null and j.status in ('queued','retry_wait','blocked') then
   update app_private.acquisition_jobs set status='failed',error_code='metadata_unavailable',retryable=true,state_revision=state_revision+1
   where id=j.id;
  end if;
  chosen:=p_operation_id;
  insert into app_private.acquisition_jobs(id,kind,source_slot_id,slot_generation,source_id,requested_revision,input_sha256,stage,slots_held,execution_contract)
  values(chosen,'lookup',slot.id,slot.generation+1,src,p_requested_revision,digest,'atom',24,'metadata-v2');
  update app_private.acquisition_source_slots set generation=generation+1,active_job_id=chosen where id=slot.id;
 end if;
 insert into app_private.acquisition_commands(id,request_sha256,job_id) values(p_operation_id,digest,chosen);
 return jsonb_build_object('job',app_private.acquisition_job_entry(chosen),'replayed',false);
end $$;
-- Retry retains the failed lookup's immutable observation. A pinned license
-- retry is not a refresh of the unversioned shared source cache.

create or replace function public.worker_retry_lookup(p_operation_id uuid,p_previous_job_id uuid) returns jsonb
language plpgsql security definer set search_path='' as $$
declare old app_private.acquisition_jobs; j app_private.acquisition_jobs; slot app_private.acquisition_source_slots;
 command app_private.acquisition_commands; digest bytea; chosen uuid; p app_private.acquisition_policy;
begin
 if p_operation_id is null or p_previous_job_id is null then raise exception 'invalid_acquisition_request'; end if;
 digest:=sha256(convert_to(jsonb_build_array('retry-lookup',p_previous_job_id)::text,'UTF8'));
 select * into strict p from app_private.acquisition_policy where singleton for update;
 select * into command from app_private.acquisition_commands where id=p_operation_id;
 if found then
  if command.request_sha256<>digest then raise exception 'operation_id_conflict'; end if;
  return jsonb_build_object('job',app_private.acquisition_job_entry(command.job_id),'replayed',true);
 end if;
 select * into old from app_private.acquisition_jobs where id=p_previous_job_id and kind='lookup';
 if not found or old.status<>'failed' or not old.retryable then raise exception 'acquisition_retry_unavailable'; end if;
 select * into slot from app_private.acquisition_source_slots where id=old.source_slot_id for no key update;
 select * into j from app_private.acquisition_jobs where kind='lookup' and execution_contract='metadata-v2' and input_sha256=digest
  and status in ('queued','leased','retry_wait','blocked','complete') and created_at+make_interval(secs=>p.retry_age_seconds)>clock_timestamp()
  order by created_at desc,id limit 1 for no key update;
 if found then chosen:=j.id; perform app_private.acquisition_admit(0,false);
 else
  perform app_private.acquisition_admit(24,false); chosen:=p_operation_id;
  update app_private.acquisition_source_slots set generation=generation+1 where id=slot.id returning * into slot;
  insert into app_private.acquisition_jobs(id,kind,source_slot_id,slot_generation,source_id,requested_revision,input_sha256,
   metadata_id,version_id,source_revision,atom_published_at,atom_updated_at,stage,slots_held,execution_contract)
  values(chosen,'lookup',slot.id,slot.generation,old.source_id,old.requested_revision,digest,old.metadata_id,old.version_id,
   old.source_revision,old.atom_published_at,old.atom_updated_at,case when old.metadata_id is null then 'atom' else 'license' end,24,'metadata-v2');
 end if;
 insert into app_private.acquisition_commands(id,request_sha256,job_id) values(p_operation_id,digest,chosen);
 return jsonb_build_object('job',app_private.acquisition_job_entry(chosen),'replayed',false);
end $$;

create or replace function app_private.acquisition_job_entry(p_id uuid) returns jsonb language sql stable security definer set search_path='' as $$
 select jsonb_build_object('id',j.id,'kind',j.kind,'execution_contract',j.execution_contract,'source_id',j.source_id,'requested_revision',j.requested_revision,'source_revision',j.source_revision,
  'metadata_id',j.metadata_id,'version_id',j.version_id,'metadata',m.metadata,
  'atom_published_at',to_char(j.atom_published_at at time zone 'UTC','YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
  'atom_updated_at',to_char(j.atom_updated_at at time zone 'UTC','YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
  'stage',j.stage,'status',j.status,'state_revision',j.state_revision,'generation',j.generation,
  'claim_id',j.claim_id,'lease_until',j.lease_until,'hard_deadline',j.hard_deadline,'next_attempt_at',j.next_attempt_at,
  'eligibility',j.eligibility,'license_uri',j.license_uri,'evidence',j.evidence,'source_detail',j.source_detail,'error_code',j.error_code,'retryable',j.retryable,
  'document_id',j.document_id,'original_object_id',j.original_object_id,'approval_id',j.approval_id,
  'reservations',(select coalesce(jsonb_agg(jsonb_build_object('id',r.id,'state',r.state,'generation',r.generation,'verification_generation',r.verification_generation) order by r.id),'[]'::jsonb) from app_private.paper_asset_reservations r where r.job_id=j.id))
 from app_private.acquisition_jobs j left join app_private.catalog_metadata m on m.id=j.metadata_id where j.id=p_id
$$;

create or replace function app_private.bound_acquisition_records() returns trigger language plpgsql set search_path='' as $$
declare cap integer; p app_private.acquisition_policy; held bigint; jobs bigint; commands bigint;
begin
 if TG_TABLE_NAME='acquisition_transfer_windows' then
  select max_rows into strict cap from app_private.acquisition_transfer_capacity where singleton for update;
  if not exists(select 1 from app_private.acquisition_transfer_windows where (period,scope,kind)=(new.period,new.scope,new.kind))
   and (select count(*) from app_private.acquisition_transfer_windows)>=cap then raise exception 'acquisition_transfer_row_limit'; end if;
 else
  select * into strict p from app_private.acquisition_policy where singleton for update;
  if (select count(*) from app_private.paper_verification_profiles)>=32 then raise exception 'verification_profile_limit'; end if;
  select count(*),coalesce(sum(slots_held),0) into jobs,held from app_private.acquisition_jobs;
  select count(*) into commands from app_private.acquisition_commands;
  if (32+jobs+held+commands+(select count(*) from app_private.acquisition_source_slots)+2*((select count(*) from app_private.paper_verification_profiles)+1))*8192>p.control_bytes then raise exception 'acquisition_control_capacity'; end if;
 end if;
 return new;
end $$;

create function public.worker_install_metadata_executor_policy(p_id uuid,p_canonical_policy text) returns jsonb
language plpgsql security definer set search_path='' as $$
declare d jsonb; old app_private.executor_policies; digest bytea; k text;
begin
 perform app_private.require_executor_role('science_reader_executor_admitter');
 if p_id is null or p_canonical_policy is null or octet_length(p_canonical_policy)>8192 then raise exception 'invalid_executor_policy'; end if;
 d:=p_canonical_policy::jsonb; digest:=sha256(convert_to(p_canonical_policy,'UTF8'));
 if jsonb_typeof(d) is distinct from 'object' or (select count(*) from jsonb_object_keys(d))<>10
  or d->'version' is distinct from '1'::jsonb or d->>'kind' is distinct from 'metadata-owned-child-v1'
  or d->>'connection_model' is distinct from 'direct-owned-socket-v1' or d->'max_executors' is distinct from '1'::jsonb
  or (d-'version'-'kind'-'connection_model'-'max_executors'-'runner_sha256'-'transport_sha256'-'observer_sha256'-'admission_sha256'-'max_useful_seconds'-'max_report_seconds')<>'{}'::jsonb
  then raise exception 'invalid_executor_policy'; end if;
 foreach k in array array['runner_sha256','transport_sha256','observer_sha256','admission_sha256'] loop
  if jsonb_typeof(d->k) is distinct from 'string' or d->>k!~'^[0-9a-f]{64}$' then raise exception 'invalid_executor_policy'; end if;
 end loop;
 if jsonb_typeof(d->'max_useful_seconds') is distinct from 'number' or d->>'max_useful_seconds'!~'^[1-9][0-9]{0,2}$'
  or jsonb_typeof(d->'max_report_seconds') is distinct from 'number' or d->>'max_report_seconds'!~'^[1-9][0-9]{0,2}$'
  or (d->>'max_useful_seconds')::integer>120 or (d->>'max_report_seconds')::integer>120
  or (d->>'max_report_seconds')::integer<(d->>'max_useful_seconds')::integer then raise exception 'invalid_executor_policy'; end if;
 perform 1 from app_private.executor_authority where singleton for update;
 select * into old from app_private.executor_policies where id=p_id;
 if found then
  if old.policy_sha256<>digest then raise exception 'operation_id_conflict'; end if;
  return jsonb_build_object('id',old.id,'sha256',encode(digest,'hex'),'replayed',true);
 end if;
 if (select count(*) from app_private.executor_policies)>=8 then raise exception 'executor_policy_capacity'; end if;
 insert into app_private.executor_policies(id,policy_sha256,canonical_policy,definition,kind,runner_sha256,transport_sha256,
  observer_sha256,admission_sha256,useful_seconds,report_seconds)
 values(p_id,digest,p_canonical_policy,d,d->>'kind',decode(d->>'runner_sha256','hex'),decode(d->>'transport_sha256','hex'),
  decode(d->>'observer_sha256','hex'),decode(d->>'admission_sha256','hex'),(d->>'max_useful_seconds')::integer,(d->>'max_report_seconds')::integer);
 return jsonb_build_object('id',p_id,'sha256',encode(digest,'hex'),'replayed',false);
end $$;

create function public.worker_metadata_authority_state() returns jsonb
language plpgsql stable security definer set search_path='' as $$
begin
 if current_setting('role',true) not in ('science_reader_metadata_executor','science_reader_execution_observer','science_reader_executor_admitter')
  then raise exception 'executor_authority_required' using errcode='42501'; end if;
 return (select jsonb_build_object('revision',revision,'project_ref',project_ref,'environment',environment,'epoch',epoch,
  'enabled',enabled,'recovery_required',recovery_required,'policy_id',active_policy_id,
  'legacy_unsettled',app_private.legacy_execution_unsettled(),
  'outstanding_executors',(select count(*) from app_private.execution_attempts e where app_private.execution_pending(e.id,'executor')),
  'outstanding_connections',(select count(*) from app_private.execution_attempts e where app_private.execution_pending(e.id,'arxiv_connection')))
  from app_private.executor_authority where singleton);
end $$;

create function public.worker_retire_metadata_executor(p_expected_revision bigint) returns jsonb
language plpgsql security definer set search_path='' as $$
declare a app_private.executor_authority;
begin
 perform app_private.require_executor_role('science_reader_executor_admitter');
 select * into strict a from app_private.executor_authority where singleton for update;
 if p_expected_revision is distinct from a.revision then raise exception 'stale_executor_authority'; end if;
 update app_private.executor_authority set enabled=false,recovery_required=true,revision=revision+1 where singleton;
 update app_private.acquisition_policy set metadata_enabled=false where singleton;
 return public.worker_metadata_authority_state();
end $$;
create function public.worker_activate_metadata_executor(p_expected_revision bigint,p_project_ref text,p_policy_id uuid,p_recovery_evidence_sha256 bytea) returns jsonb
language plpgsql security definer set search_path='' as $$
declare a app_private.executor_authority;
begin
 perform app_private.require_executor_role('science_reader_executor_admitter');
 select * into strict a from app_private.executor_authority where singleton for update;
 if p_expected_revision is distinct from a.revision then raise exception 'stale_executor_authority'; end if;
 if a.enabled or p_project_ref is null or p_project_ref!~'^[a-z]{20}$'
  or (a.project_ref is not null and a.project_ref<>p_project_ref)
  or p_recovery_evidence_sha256 is null or octet_length(p_recovery_evidence_sha256)<>32
  or not exists(select 1 from app_private.executor_policies where id=p_policy_id)
  then raise exception 'invalid_executor_activation'; end if;
 if app_private.legacy_execution_unsettled() or exists(select 1 from app_private.execution_attempts e
  where app_private.execution_pending(e.id,'executor') or app_private.execution_pending(e.id,'arxiv_connection'))
  then raise exception 'executor_recovery_required'; end if;
 -- No elapsed deadline, host experiment, or arbitrary JSON can discharge holds.
 update app_private.executor_authority set project_ref=p_project_ref,active_policy_id=p_policy_id,epoch=gen_random_uuid(),
  enabled=true,recovery_required=false,recovery_evidence_sha256=p_recovery_evidence_sha256,revision=revision+1 where singleton;
 update app_private.acquisition_policy set metadata_enabled=true where singleton;
 return public.worker_metadata_authority_state();
end $$;

create function app_private.validate_metadata_executor_binding(b jsonb,a app_private.executor_authority,p app_private.executor_policies) returns void
language plpgsql set search_path='' as $$
declare k text;
begin
 if b is null or jsonb_typeof(b)<>'object' or octet_length(b::text)>2048
  or (b-'version'-'project_ref'-'environment'-'epoch'-'policy_id'-'runner_sha256'-'transport_sha256'-'observer_sha256'-'deployment_id'-'host_id'-'boot_id'-'process_id'-'process_start_id'-'child_id')<>'{}'::jsonb
  or (select count(*) from jsonb_object_keys(b))<>14 or b->'version' is distinct from '1'::jsonb
  or b->>'project_ref' is distinct from a.project_ref or b->>'environment' is distinct from a.environment
  or b->>'epoch' is distinct from a.epoch::text or b->>'policy_id' is distinct from p.id::text
  or b->>'runner_sha256' is distinct from encode(p.runner_sha256,'hex')
  or b->>'transport_sha256' is distinct from encode(p.transport_sha256,'hex')
  or b->>'observer_sha256' is distinct from encode(p.observer_sha256,'hex')
  or jsonb_typeof(b->'deployment_id') is distinct from 'string' or b->>'deployment_id'!~'^[A-Za-z0-9_.:-]{1,128}$'
  or jsonb_typeof(b->'process_id') is distinct from 'number' or b->>'process_id'!~'^[1-9][0-9]{0,9}$'
  or (b->>'process_id')::bigint>2147483647
  or jsonb_typeof(b->'process_start_id') is distinct from 'string' or b->>'process_start_id'!~'^[0-9]{1,20}$'
  then raise exception 'invalid_executor_binding'; end if;
 foreach k in array array['host_id','boot_id','child_id'] loop
  if jsonb_typeof(b->k) is distinct from 'string' or b->>k!~'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
   then raise exception 'invalid_executor_binding'; end if;
 end loop;
end $$;

create function public.worker_claim_metadata_stage_v2(p_job_id uuid,p_claim_id uuid,p_environment text,p_executor_binding jsonb) returns jsonb
language plpgsql security definer set search_path='' as $$
declare a app_private.executor_authority; ep app_private.executor_policies; j app_private.acquisition_jobs;
 p app_private.acquisition_policy; g app_private.arxiv_network_gate; e app_private.execution_attempts; old app_private.execution_attempts;
 s app_private.acquisition_steps; digest bytea; n integer; started timestamptz; d date; month date; used bigint; attempt uuid;
begin
 perform app_private.require_executor_role('science_reader_metadata_executor');
 if p_job_id is null or p_claim_id is null or p_environment is null or p_executor_binding is null
  or jsonb_typeof(p_executor_binding)<>'object' or octet_length(p_executor_binding::text)>2048 then raise exception 'invalid_acquisition_claim'; end if;
 digest:=sha256(convert_to(jsonb_build_array('metadata-stage-v2',p_job_id,p_claim_id,p_environment,p_executor_binding)::text,'UTF8'));
 select * into strict a from app_private.executor_authority where singleton for update;
 select * into strict g from app_private.arxiv_network_gate where singleton for update;
 select * into j from app_private.acquisition_jobs where id=p_job_id for no key update;
 if not found then raise exception 'acquisition_unavailable'; end if;
 select * into s from app_private.acquisition_steps where job_id=j.id and operation_id=p_claim_id for no key update;
 if found then
  if s.kind<>'metadata_stage_v2' or s.request_sha256<>digest then raise exception 'operation_id_conflict'; end if;
  select * into strict e from app_private.execution_attempts where job_id=j.id and operation_id=p_claim_id;
  return jsonb_build_object('granted',false,'action','reconcile','job',app_private.acquisition_job_entry(j.id),'execution',app_private.execution_entry(e.id));
 end if;
 if j.execution_contract<>'metadata-v2' or j.kind<>'lookup' or j.slots_held<>24 then raise exception 'metadata_execution_contract_required'; end if;
 if not a.enabled or a.recovery_required or a.active_policy_id is null then
  return jsonb_build_object('granted',false,'action','disabled','job',app_private.acquisition_job_entry(j.id)); end if;
 if p_environment<>a.environment then raise exception 'arxiv_outbound_disabled'; end if;
 select * into strict ep from app_private.executor_policies where id=a.active_policy_id;
 perform app_private.validate_metadata_executor_binding(p_executor_binding,a,ep);
 select * into strict p from app_private.acquisition_policy;
 if not p.metadata_enabled or p.gateway_environment<>p_environment then return jsonb_build_object('granted',false,'action','disabled','job',app_private.acquisition_job_entry(j.id)); end if;
 if j.status in ('complete','failed','no_interest') then return jsonb_build_object('granted',false,'action','terminal','job',app_private.acquisition_job_entry(j.id)); end if;
 if j.stage not in ('atom','license') then raise exception 'invalid_acquisition_stage'; end if;
 -- No time-based gate takeover. Resources remain occupied across lease/epoch/month.
 if g.token is not null or app_private.legacy_execution_unsettled()
  or exists(select 1 from app_private.execution_attempts x where app_private.execution_pending(x.id,'executor') or app_private.execution_pending(x.id,'arxiv_connection')) then
  return jsonb_build_object('granted',false,'action','wait','reason','unsettled_execution','next_allowed_at',null,'job',app_private.acquisition_job_entry(j.id)); end if;
 if j.next_attempt_at>clock_timestamp() or g.next_allowed_at>clock_timestamp() or (j.status='leased' and j.lease_until>clock_timestamp()) then
  return jsonb_build_object('granted',false,'action','wait','reason','cooldown','next_allowed_at',greatest(j.next_attempt_at,g.next_allowed_at,case when j.status='leased' then j.lease_until end),'job',app_private.acquisition_job_entry(j.id)); end if;
 if exists(select 1 from app_private.execution_attempts x where x.child_id=(p_executor_binding->>'child_id')::uuid
  or (x.host_id,x.boot_id,x.process_id,x.process_start_id)=((p_executor_binding->>'host_id')::uuid,(p_executor_binding->>'boot_id')::uuid,(p_executor_binding->>'process_id')::bigint,p_executor_binding->>'process_start_id')) then raise exception 'executor_binding_already_used'; end if;
 perform 1 from app_private.acquisition_transfer_capacity where singleton for update;
 d:=(clock_timestamp() at time zone 'UTC')::date; month:=date_trunc('month',clock_timestamp() at time zone 'UTC')::date;
 perform 1 from app_private.acquisition_transfer_windows where scope='environment'
  and ((period=d and kind='source_requests') or (period=month and kind='source_bytes')) order by period,scope,kind for no key update;
 select * into strict p from app_private.acquisition_policy;
 if not p.metadata_enabled or p.gateway_environment<>p_environment then return jsonb_build_object('granted',false,'action','disabled','job',app_private.acquisition_job_entry(j.id)); end if;
 if not app_private.acquisition_has_interest(j.id) then return jsonb_build_object('granted',false,'action','no_interest','job',app_private.acquisition_job_entry(j.id)); end if;
 select count(*) into n from app_private.execution_attempts where job_id=j.id;
 if n<>(select count(*) from app_private.acquisition_steps where job_id=j.id)
  or n<>j.atom_attempts+j.license_attempts then raise exception 'execution_envelope_integrity'; end if;
 if j.created_at+make_interval(secs=>p.retry_age_seconds)<=clock_timestamp() or (j.stage='atom' and j.atom_attempts>=3)
  or (j.stage='license' and j.license_attempts>=3) then
  if j.status='leased' then
   perform app_private.acquisition_finish_step(j.id,j.claim_id,jsonb_build_object('error_code','metadata_unavailable','retryable',true),'uncertain');
  end if;
  update app_private.acquisition_jobs set status='failed',error_code='metadata_unavailable',retryable=true,
   state_revision=state_revision+1,claim_id=null,lease_until=null,hard_deadline=null where id=j.id;
  return jsonb_build_object('granted',false,'action','terminal','job',app_private.acquisition_job_entry(j.id)); end if;
 if 4*(n+1)>j.slots_held then raise exception 'acquisition_attempt_limit'; end if;
 -- An expired result can never arrive for a replacement generation. Its two
 -- resources are already proven closed above; settle its existing step in place.
 if j.status='leased' then
  select * into strict old from app_private.execution_attempts where job_id=j.id and operation_id=j.claim_id;
  if old.report_deadline>clock_timestamp() then raise exception 'stale_acquisition_lease'; end if;
  perform app_private.acquisition_finish_step(j.id,j.claim_id,jsonb_build_object('error_code','metadata_unavailable','retryable',true),'uncertain');
 end if;
 insert into app_private.acquisition_transfer_windows(period,scope,kind,charged) values(d,'environment','source_requests',1)
 on conflict(period,scope,kind) do update set charged=app_private.acquisition_transfer_windows.charged+1 returning charged into used;
 if used>p.source_requests_day then raise exception 'arxiv_daily_limit'; end if;
 insert into app_private.acquisition_transfer_windows(period,scope,kind,charged) values(month,'environment','source_bytes',1048576)
 on conflict(period,scope,kind) do update set charged=app_private.acquisition_transfer_windows.charged+excluded.charged returning charged into used;
 if used>p.source_download_bytes_month then raise exception 'acquisition_source_transfer_limit'; end if;
 started:=clock_timestamp(); attempt:=gen_random_uuid();
 insert into app_private.acquisition_steps(job_id,operation_id,request_sha256,kind,generation,stage,
  network_token,network_granted_at,network_byte_ceiling,network_period)
 values(j.id,p_claim_id,digest,'metadata_stage_v2',j.generation+1,j.stage,attempt,started,1048576,month);
 insert into app_private.execution_attempts(id,job_id,operation_id,generation,kind,request_sha256,epoch,policy_id,project_ref,environment,binding,binding_sha256,
  host_id,boot_id,process_id,process_start_id,child_id,useful_deadline,report_deadline,byte_ceiling,charge_period,created_at)
 values(attempt,j.id,p_claim_id,j.generation+1,j.stage,digest,a.epoch,ep.id,a.project_ref,a.environment,p_executor_binding,sha256(convert_to(p_executor_binding::text,'UTF8')),
  (p_executor_binding->>'host_id')::uuid,(p_executor_binding->>'boot_id')::uuid,(p_executor_binding->>'process_id')::bigint,p_executor_binding->>'process_start_id',(p_executor_binding->>'child_id')::uuid,
  started+make_interval(secs=>least(ep.useful_seconds,p.stage_lease_seconds)),started+make_interval(secs=>least(ep.report_seconds,p.stage_lease_seconds)),1048576,month,started);
 update app_private.acquisition_jobs set generation=generation+1,claim_id=p_claim_id,status='leased',state_revision=state_revision+1,
  lease_until=started+make_interval(secs=>least(ep.report_seconds,p.stage_lease_seconds)),hard_deadline=null,
  atom_attempts=atom_attempts+case when stage='atom' then 1 else 0 end,
  license_attempts=license_attempts+case when stage='license' then 1 else 0 end where id=j.id;
 update app_private.arxiv_network_gate set token=attempt,job_id=j.id,operation_id=p_claim_id,generation=generation+1,
  granted_at=started,hard_deadline=null where singleton;
 return jsonb_build_object('granted',true,'action','perform_stage','job',app_private.acquisition_job_entry(j.id),'execution',app_private.execution_entry(attempt));
end $$;

create function public.worker_record_metadata_quiescence(p_attempt_id uuid,p_receipt_id uuid,p_resource text,p_evidence_kind text,p_facts jsonb) returns jsonb
language plpgsql security definer set search_path='' as $$
declare e app_private.execution_attempts; q app_private.execution_quiescence; s app_private.acquisition_steps; g app_private.arxiv_network_gate;
 digest bytea; measured bigint; retry integer; frame text;
begin
 perform app_private.require_executor_role('science_reader_execution_observer');
 if p_attempt_id is null or p_receipt_id is null or p_resource is null or p_resource not in ('executor','arxiv_connection')
  or p_evidence_kind is distinct from 'owned_child_joined' or p_facts is null or jsonb_typeof(p_facts)<>'object' or octet_length(p_facts::text)>2048
  then raise exception 'invalid_execution_evidence'; end if;
 digest:=sha256(convert_to(jsonb_build_array('metadata-quiescence-v1',p_attempt_id,p_resource,p_evidence_kind,p_facts)::text,'UTF8'));
 perform 1 from app_private.executor_authority where singleton for update;
 if p_resource='arxiv_connection' then select * into strict g from app_private.arxiv_network_gate where singleton for update; end if;
 select * into e from app_private.execution_attempts where id=p_attempt_id;
 if not found then raise exception 'execution_unavailable'; end if;
 select * into q from app_private.execution_quiescence where receipt_id=p_receipt_id;
 if found then
  if q.request_sha256<>digest then raise exception 'operation_id_conflict'; end if;
  return jsonb_build_object('replayed',true,'receipt_id',q.receipt_id,'execution',app_private.execution_entry(p_attempt_id));
 end if;
 select * into q from app_private.execution_quiescence where attempt_id=p_attempt_id and resource=p_resource;
 if found then
  if q.request_sha256<>digest then raise exception 'operation_id_conflict'; end if;
  -- A redundant proof does not reserve its new ID or allocate an alias row.
  -- The observer receives the existing canonical receipt for future recovery.
  return jsonb_build_object('replayed',true,'receipt_id',q.receipt_id,'execution',app_private.execution_entry(p_attempt_id));
 end if;
 if p_facts->>'binding_sha256' is distinct from encode(e.binding_sha256,'hex')
  or p_facts->>'disposition' is null or p_facts->>'disposition' not in ('exited','killed') then raise exception 'execution_evidence_binding'; end if;
 if p_resource='executor' then
  if (p_facts-'binding_sha256'-'disposition')<>'{}'::jsonb then raise exception 'invalid_execution_evidence'; end if;
 else
  if (p_facts-'binding_sha256'-'disposition'-'framing'-'peer_eof'-'actual_bytes'-'body_sha256'-'status_code'-'retry_after_seconds')<>'{}'::jsonb
   or (select count(*) from jsonb_object_keys(p_facts))<>8
   or jsonb_typeof(p_facts->'peer_eof') is distinct from 'boolean'
   or jsonb_typeof(p_facts->'retry_after_seconds') is distinct from 'number' or p_facts->>'retry_after_seconds'!~'^(0|[1-9][0-9]{0,4})$'
   or (p_facts->>'retry_after_seconds')::integer>86400 then raise exception 'invalid_execution_evidence'; end if;
  frame:=p_facts->>'framing'; retry:=(p_facts->>'retry_after_seconds')::integer;
  if frame is null or frame not in ('unknown','content_length','chunked','close_delimited') then raise exception 'invalid_execution_evidence'; end if;
  if frame='unknown' then
   if p_facts->'actual_bytes' is distinct from 'null'::jsonb or p_facts->'body_sha256' is distinct from 'null'::jsonb
    or (p_facts->'status_code' is distinct from 'null'::jsonb and
     (jsonb_typeof(p_facts->'status_code') is distinct from 'number' or p_facts->>'status_code'!~'^[1-5][0-9]{2}$'))
    then raise exception 'invalid_execution_evidence'; end if;
   -- Complete headers can establish status/Retry-After even when no complete
   -- body exists. Preserve the delay without granting result or refund authority.
  else
   if p_facts->>'disposition'<>'exited' or (frame='close_delimited' and p_facts->'peer_eof'<>'true'::jsonb)
    or jsonb_typeof(p_facts->'actual_bytes') is distinct from 'number' or p_facts->>'actual_bytes'!~'^(0|[1-9][0-9]{0,6})$'
    or (p_facts->>'actual_bytes')::bigint>e.byte_ceiling
    or jsonb_typeof(p_facts->'body_sha256') is distinct from 'string' or p_facts->>'body_sha256'!~'^[0-9a-f]{64}$'
    or jsonb_typeof(p_facts->'status_code') is distinct from 'number' or p_facts->>'status_code'!~'^[1-5][0-9]{2}$'
    then raise exception 'invalid_execution_evidence'; end if;
   measured:=(p_facts->>'actual_bytes')::bigint;
  end if;
  select * into strict s from app_private.acquisition_steps where job_id=e.job_id and operation_id=e.operation_id for no key update;
  if s.network_token is distinct from e.id or s.network_closed_at is not null or g.token is distinct from e.id
   then raise exception 'execution_gate_integrity'; end if;
 end if;
 -- These two rows were fully reserved before I/O. Never re-admit against a full
 -- pool or today's kill switch, and never reinterpret an expired lease as proof.
 insert into app_private.execution_quiescence(attempt_id,resource,receipt_id,request_sha256,evidence_kind,facts)
 values(e.id,p_resource,p_receipt_id,digest,p_evidence_kind,p_facts);
 if p_resource='arxiv_connection' then
  if measured is not null then
   update app_private.acquisition_transfer_windows set charged=charged-(e.byte_ceiling-measured)
    where period=e.charge_period and scope='environment' and kind='source_bytes' and charged>=e.byte_ceiling-measured;
   if not found then raise exception 'execution_charge_integrity'; end if;
  end if;
  update app_private.acquisition_steps set network_closed_at=clock_timestamp(),network_actual_bytes=measured,network_retry_after_seconds=retry
   where job_id=e.job_id and operation_id=e.operation_id;
  update app_private.arxiv_network_gate set token=null,job_id=null,operation_id=null,granted_at=null,hard_deadline=null,
   next_allowed_at=greatest(next_allowed_at,clock_timestamp()+make_interval(secs=>greatest(3,retry))) where singleton;
 end if;
 return jsonb_build_object('replayed',false,'receipt_id',p_receipt_id,'execution',app_private.execution_entry(p_attempt_id));
end $$;

create function public.worker_metadata_execution_state(p_job_id uuid,p_claim_id uuid) returns jsonb
language plpgsql stable security definer set search_path='' as $$
begin
 if current_setting('role',true) not in ('science_reader_metadata_executor','science_reader_execution_observer')
  then raise exception 'executor_authority_required' using errcode='42501'; end if;
 if p_job_id is null or p_claim_id is null then raise exception 'invalid_acquisition_claim'; end if;
 return jsonb_build_object('job',app_private.acquisition_job_entry(p_job_id),
  'execution',(select app_private.execution_entry(id) from app_private.execution_attempts where job_id=p_job_id and operation_id=p_claim_id),
  'step_result',(select result from app_private.acquisition_steps where job_id=p_job_id and operation_id=p_claim_id));
end $$;
create function public.worker_scan_unsettled_metadata_executions(p_after_attempt_id uuid default null,p_limit integer default 50) returns jsonb
language plpgsql stable security definer set search_path='' as $$
begin
 if current_setting('role',true) not in ('science_reader_metadata_executor','science_reader_execution_observer','science_reader_executor_admitter')
  then raise exception 'executor_authority_required' using errcode='42501'; end if;
 if p_limit is null or p_limit not between 1 and 100 then raise exception 'invalid_executor_scan'; end if;
 return (select coalesce(jsonb_agg(app_private.execution_entry(id) order by id),'[]'::jsonb) from
  (select id from app_private.execution_attempts where (p_after_attempt_id is null or id>p_after_attempt_id)
   and (app_private.execution_pending(id,'executor') or app_private.execution_pending(id,'arxiv_connection')) order by id limit p_limit) s);
end $$;
create function public.worker_scan_metadata_jobs_v2(p_after_id uuid default null,p_limit integer default 50) returns jsonb
language plpgsql stable security definer set search_path='' as $$
begin
 perform app_private.require_executor_role('science_reader_metadata_executor');
 if p_limit is null or p_limit not between 1 and 100 then raise exception 'invalid_executor_scan'; end if;
 return (select coalesce(jsonb_agg(app_private.acquisition_job_entry(id) order by id),'[]'::jsonb) from
  (select j.id from app_private.acquisition_jobs j where j.execution_contract='metadata-v2' and j.stage in ('atom','license')
   and j.status in ('queued','retry_wait','leased') and j.next_attempt_at<=clock_timestamp()
   and (j.lease_until is null or j.lease_until<=clock_timestamp()) and (p_after_id is null or j.id>p_after_id)
   and app_private.acquisition_has_interest(j.id) order by j.id limit p_limit) s);
end $$;

create function public.worker_finish_metadata_stage_v2(p_job_id uuid,p_claim_id uuid,p_generation bigint,p_attempt_id uuid,p_body_sha256 bytea,p_result jsonb) returns jsonb
language plpgsql security definer set search_path='' as $$
declare a app_private.executor_authority; e app_private.execution_attempts; q app_private.execution_quiescence; j app_private.acquisition_jobs; s app_private.acquisition_steps; slot app_private.acquisition_source_slots; p app_private.acquisition_policy;
 meta uuid; m app_private.catalog_metadata; revision integer; eligible boolean; proof jsonb; published timestamptz; updated timestamptz; license text;
 digest bytea:=sha256(convert_to(jsonb_build_array(p_attempt_id,encode(p_body_sha256,'hex'),p_result)::text,'UTF8'));
begin
 perform app_private.require_executor_role('science_reader_metadata_executor');
 if p_body_sha256 is null or octet_length(p_body_sha256)<>32 or p_attempt_id is null then raise exception 'invalid_acquisition_result'; end if;
 select * into strict a from app_private.executor_authority where singleton for update;
 if p_result is null or jsonb_typeof(p_result)<>'object' or octet_length(p_result::text)>40960 then raise exception 'invalid_acquisition_result'; end if;
 select * into strict p from app_private.acquisition_policy where singleton for update;
 select * into j from app_private.acquisition_jobs where id=p_job_id and kind='lookup';
 if not found then raise exception 'acquisition_unavailable'; end if;
 select * into slot from app_private.acquisition_source_slots where id=j.source_slot_id for no key update;
 select * into j from app_private.acquisition_jobs where id=p_job_id for no key update;
 select * into s from app_private.acquisition_steps where job_id=p_job_id and operation_id=p_claim_id;
 if s.result_sha256 is not null then
  if s.generation is distinct from p_generation or s.result->>'input_sha256' is distinct from encode(digest,'hex') then raise exception 'operation_id_conflict'; end if;
  return app_private.acquisition_job_entry(j.id);
 end if;
 select * into e from app_private.execution_attempts where id=p_attempt_id and job_id=j.id and operation_id=p_claim_id;
 if e.id is null or e.generation is distinct from p_generation or e.kind is distinct from j.stage then raise exception 'stale_execution_attempt'; end if;
 select * into q from app_private.execution_quiescence where attempt_id=e.id and resource='arxiv_connection';
 if not a.enabled or a.recovery_required or a.epoch<>e.epoch or not p.metadata_enabled or e.report_deadline<=clock_timestamp()
  or j.execution_contract<>'metadata-v2' or q.facts->>'framing' is null or q.facts->>'framing'='unknown'
  or q.facts->>'status_code' is distinct from '200' or q.facts->>'body_sha256' is distinct from encode(p_body_sha256,'hex')
  then raise exception 'stale_execution_attempt'; end if;
 if j.status<>'leased' or j.claim_id is distinct from p_claim_id or j.generation is distinct from p_generation or j.lease_until<=clock_timestamp()
  or s.network_closed_at is null or s.generation<>j.generation or j.stage not in ('atom','license') then raise exception 'stale_acquisition_lease'; end if;
 if j.stage='atom' then
  if (p_result-'revision'-'metadata'-'atom_published_at'-'atom_updated_at')<>'{}'::jsonb or jsonb_typeof(p_result->'revision') is distinct from 'number'
   or (p_result->>'revision')!~'^[1-9][0-9]{0,9}$' then raise exception 'invalid_source_metadata'; end if;
  revision:=(p_result->>'revision')::integer;
  if j.requested_revision is not null and j.requested_revision<>revision then raise exception 'acquisition_source_mismatch'; end if;
  if p_result->>'atom_published_at' is not null then published:=(p_result->>'atom_published_at')::timestamptz; end if;
  if p_result->>'atom_updated_at' is not null then updated:=(p_result->>'atom_updated_at')::timestamptz; end if;
  if (p_result->'metadata'->>'published_at') is distinct from to_char(published at time zone 'UTC','YYYY-MM-DD')
   or (p_result->'metadata'->>'updated_at') is distinct from to_char(updated at time zone 'UTC','YYYY-MM-DD') then raise exception 'source_timestamp_mismatch'; end if;
  meta:=public.worker_record_arxiv_metadata(j.source_id,revision,p_result->'metadata');
  select * into strict m from app_private.catalog_metadata where id=meta;
  update app_private.acquisition_jobs set metadata_id=meta,version_id=m.version_id,source_revision=revision,error_code=null,retryable=false,
   atom_published_at=published,atom_updated_at=updated,stage='license',status='queued',state_revision=state_revision+1,
   claim_id=null,lease_until=null,hard_deadline=null,next_attempt_at=clock_timestamp()
   where id=j.id;
 else
  if (p_result-'eligible'-'license_uri'-'evidence'-'reason')<>'{}'::jsonb or jsonb_typeof(p_result->'eligible') is distinct from 'boolean' then raise exception 'invalid_reuse_decision'; end if;
  eligible:=(p_result->>'eligible')::boolean;
  if eligible then
   proof:=p_result->'evidence'; license:=p_result->>'license_uri';
   if license is null or license not in ('https://creativecommons.org/licenses/by/4.0/','https://creativecommons.org/publicdomain/zero/1.0/')
    or jsonb_typeof(proof) is distinct from 'object' or octet_length(proof::text)>4096
    or proof->>'source_id' is distinct from j.source_id or proof->>'source_revision' is distinct from j.source_revision::text
    or proof->>'source_url' is distinct from 'https://arxiv.org/abs/'||j.source_id||'v'||j.source_revision
    or proof->>'license_uri' is distinct from license or proof->>'evidence_format' is distinct from 'arXivRaw'
    or proof->>'evidence_sha256' is null or (proof->>'evidence_sha256')!~'^[0-9a-f]{64}$'
    or proof->>'evidence_sha256' is distinct from encode(p_body_sha256,'hex')
    or proof->>'observed_at' is null or proof->>'latest_version_at' is null
    or j.atom_updated_at is null or (proof->>'latest_version_at')::timestamptz<>j.atom_updated_at
    then raise exception 'reuse_evidence_mismatch'; end if;
   perform (proof->>'observed_at')::timestamptz;
  elsif p_result->>'reason' is null or p_result->>'reason' not in ('revision_unverified','license_unverified','license_not_supported') then raise exception 'invalid_reuse_decision';
  end if;
  update app_private.acquisition_jobs set eligibility=case when eligible then 'eligible' else 'source_only' end,error_code=null,retryable=false,
   license_uri=license,evidence=proof,source_detail=case when not eligible then p_result->>'reason' end,
   stage='complete',status='complete',state_revision=state_revision+1,claim_id=null,lease_until=null,hard_deadline=null,
   slots_held=24 where id=j.id;
  if slot.active_job_id=j.id then
   update app_private.acquisition_source_slots set cached_job_id=j.id,fresh_until=clock_timestamp()+make_interval(secs=>p.lookup_fresh_seconds)
   where id=slot.id;
  end if;
 end if;
 perform app_private.acquisition_finish_step(j.id,p_claim_id,jsonb_build_object('input_sha256',encode(digest,'hex'),'job_id',j.id));
 return app_private.acquisition_job_entry(j.id);
end $$;

create function public.worker_fail_metadata_stage_v2(p_job_id uuid,p_claim_id uuid,p_generation bigint,p_attempt_id uuid,p_error_code text,p_retryable boolean) returns jsonb
language plpgsql security definer set search_path='' as $$
declare a app_private.executor_authority; j app_private.acquisition_jobs; s app_private.acquisition_steps; e app_private.execution_attempts;
 result jsonb; retry boolean;
begin
 perform app_private.require_executor_role('science_reader_metadata_executor');
 if p_error_code is null or p_error_code not in ('metadata_unavailable','source_not_found','invalid_source_metadata','rate_limited','capacity_exhausted')
  or p_retryable is null or p_attempt_id is null then raise exception 'invalid_acquisition_error'; end if;
 result:=jsonb_build_object('attempt_id',p_attempt_id,'error_code',p_error_code,'retryable',p_retryable);
 select * into strict a from app_private.executor_authority where singleton for update;
 select * into j from app_private.acquisition_jobs where id=p_job_id for no key update;
 if not found then raise exception 'acquisition_unavailable'; end if;
 select * into s from app_private.acquisition_steps where job_id=j.id and operation_id=p_claim_id for no key update;
 if s.result_sha256 is not null then
  if s.generation is distinct from p_generation or s.result<>result then raise exception 'operation_id_conflict'; end if;
  return app_private.acquisition_job_entry(j.id);
 end if;
 select * into e from app_private.execution_attempts where id=p_attempt_id and job_id=j.id and operation_id=p_claim_id;
 if e.id is null or e.generation is distinct from p_generation or j.execution_contract<>'metadata-v2' or e.kind is distinct from j.stage
  or a.epoch<>e.epoch or not a.enabled or a.recovery_required or e.report_deadline<=clock_timestamp()
  or j.status<>'leased' or j.claim_id is distinct from p_claim_id or j.generation is distinct from p_generation then raise exception 'stale_execution_attempt'; end if;
 retry:=p_retryable and p_error_code in ('metadata_unavailable','rate_limited','capacity_exhausted')
  and case j.stage when 'atom' then j.atom_attempts<3 when 'license' then j.license_attempts<3 else false end;
 perform app_private.acquisition_finish_step(j.id,p_claim_id,result,
  case when app_private.execution_pending(e.id,'arxiv_connection') then 'uncertain' else 'failed' end);
 update app_private.acquisition_jobs set status=case when retry then 'retry_wait' else 'failed' end,error_code=p_error_code,retryable=p_retryable,
  state_revision=state_revision+1,claim_id=null,lease_until=null,hard_deadline=null,next_attempt_at=clock_timestamp()+interval '30 seconds' where id=j.id;
 return app_private.acquisition_job_entry(j.id);
end $$;

-- New RPCs have explicit capability ACLs. Old external/result routes are
-- retained for historical introspection but receive no operational grants.
do $$ declare t text; r text; f record; allowed text[]; begin
 foreach t in array array['executor_policies','executor_authority','execution_attempts','execution_quiescence'] loop
  execute format('alter table app_private.%I enable row level security',t);
  execute format('revoke all on app_private.%I from public,anon,authenticated,service_role,science_reader_pdf_verifier,science_reader_metadata_executor,science_reader_execution_observer,science_reader_executor_admitter',t);
 end loop;
 for f in select oid::regprocedure as sig from pg_proc where pronamespace='app_private'::regnamespace loop
  execute format('revoke all on function %s from public,anon,authenticated,service_role,science_reader_pdf_verifier,science_reader_metadata_executor,science_reader_execution_observer,science_reader_executor_admitter',f.sig);
 end loop;
 for f in select oid::regprocedure as sig from pg_proc where pronamespace='public'::regnamespace and proname in (
  'worker_claim_arxiv_stage','worker_finish_arxiv_request','worker_finish_lookup','worker_fail_acquisition','worker_begin_arxiv_request','worker_mark_original_uploading',
  'worker_prepare_original','worker_claim_acquisition','worker_reserve_original','worker_record_original_upload','worker_claim_original_verification',
  'worker_record_original_verification','worker_verification_input_unavailable','worker_record_original_integrity_failure','worker_publish_original','worker_bind_lookup_original',
  'worker_set_original_availability','worker_claim_original_orphans','worker_confirm_original_deleted','worker_authorize_original_read','worker_record_arxiv_metadata','worker_approve_arxiv_asset') loop
  execute format('revoke all on function %s from public,anon,authenticated,service_role,science_reader_pdf_verifier,science_reader_metadata_executor,science_reader_execution_observer,science_reader_executor_admitter',f.sig);
 end loop;
 foreach r in array array['science_reader_metadata_executor','science_reader_execution_observer','science_reader_executor_admitter'] loop
  allowed:=case r
   when 'science_reader_metadata_executor' then array['worker_claim_metadata_stage_v2','worker_finish_metadata_stage_v2','worker_fail_metadata_stage_v2',
    'worker_metadata_execution_state','worker_scan_unsettled_metadata_executions','worker_scan_metadata_jobs_v2','worker_metadata_authority_state',
    'worker_prepare_acquisition','worker_retry_lookup','worker_acquisition_state','worker_import_state','worker_scan_acquisition_imports',
    'worker_link_import_acquisition','worker_project_import_acquisition']
   when 'science_reader_execution_observer' then array['worker_record_metadata_quiescence','worker_metadata_execution_state','worker_scan_unsettled_metadata_executions','worker_metadata_authority_state']
   else array['worker_install_metadata_executor_policy','worker_retire_metadata_executor','worker_activate_metadata_executor','worker_metadata_authority_state','worker_scan_unsettled_metadata_executions'] end;
  for f in select oid::regprocedure as sig,proname from pg_proc where pronamespace='public'::regnamespace and proname=any(allowed) loop
   execute format('grant execute on function %s to %I',f.sig,r);
  end loop;
 end loop;
 -- PostgreSQL grants PUBLIC function execution by default. Remove that default
 -- from every newly introduced interface, then regrant its explicit capability.
 for f in select oid::regprocedure as sig from pg_proc where pronamespace='public'::regnamespace and proname in (
  'worker_claim_metadata_stage_v2','worker_finish_metadata_stage_v2','worker_fail_metadata_stage_v2','worker_record_metadata_quiescence',
  'worker_metadata_execution_state','worker_scan_unsettled_metadata_executions','worker_scan_metadata_jobs_v2','worker_metadata_authority_state',
  'worker_install_metadata_executor_policy','worker_retire_metadata_executor','worker_activate_metadata_executor') loop
  execute format('revoke all on function %s from public,anon,authenticated,service_role,science_reader_pdf_verifier',f.sig);
 end loop;
end $$;
commit;
