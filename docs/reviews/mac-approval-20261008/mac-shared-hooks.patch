+    /// The new Mac uses the same persisted candidate and operation lock as recovery. A request can
+    /// expire; its recipient key cannot. Only a positive revocation record retires that recipient.
+    func macApproval(refreshRequest: Bool) async throws -> MacApprovalCheck {
+        try beginOperation(); defer { operationInProgress = false }
+        var saved = try pendingEnrollment()
+        if let saved, let completed = try await finishApproved(saved) { return .ready(completed) }
+        if !refreshRequest, let saved { return .waiting(try macApprovalPayload(saved)) }
+        if let pending = saved {
+            let registrations: [DeviceRegistration] = try await backend.rpc("v1_devices", params: EmptyResponse(), accountID: accountID)
+            try Task.checkCancellation()
+            if registrations.contains(where: { $0.id == pending.candidate.deviceID && $0.revoked_at != nil }) { saved = nil }
+        }
+        let candidate = saved?.candidate ?? LocalDevice.create(accountID: accountID, localStoreKey: device.localStoreKey)
