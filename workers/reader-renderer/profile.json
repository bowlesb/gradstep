{
  "id": "timestep-mmd-v1",
  "source_kind": "authored-mmd",
  "format": "reader-bundle-v1",
  "index_format": "reader-index-v1",
  "max_source_bytes": 262144,
  "max_members": 512,
  "max_bundle_bytes": 33554432,
  "max_member_bytes": 16777216,
  "max_manifest_bytes": 262144,
  "max_html_bytes": 8388608,
  "max_index_bytes": 2097152,
  "max_text_bytes": 20000,
  "max_heading_bytes": 2000,
  "max_blocks": 5000,
  "max_headings": 500,
  "max_equations": 512,
  "max_equation_width_ex": 2048,
  "max_equation_height_ex": 256,
  "max_figures": 128,
  "max_image_dimension": 8192,
  "max_image_pixels": 16000000,
  "max_total_image_pixels": 16000000,
  "max_dom_nodes": 200000,
  "max_dom_depth": 128,
  "mathpix_version": "3.0.1",
  "markdown_it_version": "9.1.0",
  "sanitizer_version": "2.18.0",
  "htmlparser2_version": "12.0.0",
  "math_options": {
    "include_latex": true,
    "include_mathml": true,
    "include_svg": true
  },
  "raw_html": false,
  "font_cache": "none",
  "image_profile": "png-8bit-rgb-rgba-noninterlaced-v1"
}
