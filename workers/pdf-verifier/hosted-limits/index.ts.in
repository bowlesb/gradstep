import factory from './verifier.mjs';
import { createVerifier, sha256, type ModuleFactory } from './runtime.ts';
import { createHandler } from './handler.ts';
import { createAuthenticate } from './auth.ts';
import type { Synthetic } from './workloads.ts';
import { config, profile, wasmSHA256, profileSHA256, wasmBase64, fixture,
  syntheticBase64, syntheticSHA256 } from './assets.ts';

const base = `https://${config.project}.supabase.co`;
const anon = Deno.env.get('SUPABASE_ANON_KEY');
if (Deno.env.get('SUPABASE_URL') !== base || !anon) throw new Error('invalid_probe_environment');
const decode = (value: string) => Uint8Array.from(atob(value), character => character.charCodeAt(0));
let syntheticModule: Promise<WebAssembly.Module> | undefined;

const handler = createHandler(config, {
  authenticate: createAuthenticate(config.project, anon),
  async synthetic() {
    syntheticModule ??= (async () => {
      const bytes = decode(syntheticBase64);
      if (bytes.length > 1024 || await sha256(bytes) !== syntheticSHA256) throw new Error('synthetic_identity_mismatch');
      const module = await WebAssembly.compile(bytes);
      if (WebAssembly.Module.imports(module).length !== 0 ||
          JSON.stringify(WebAssembly.Module.exports(module)) !== JSON.stringify([
            { name: 'cpu_chunk', kind: 'function' }, { name: 'chunk_iterations', kind: 'function' }, { name: 'memory', kind: 'memory' },
          ])) throw new Error('synthetic_abi_mismatch');
      return module;
    })();
    // A new memory for every case; only compiled code is retained.
    const instance = await WebAssembly.instantiate(await syntheticModule);
    return instance.exports as unknown as Synthetic;
  },
  async recover() {
    const verifier = await createVerifier({ factory: factory as unknown as ModuleFactory,
      wasm: decode(wasmBase64), wasmSHA256, profile, profileSHA256 });
    if (Date.now() < config.createdAt || Date.now() + 180_000 >= config.expiresAt) throw new Error('probe_expired');
    const bytes = decode(fixture.base64);
    if (bytes.length !== fixture.bytes || await sha256(bytes) !== fixture.sha256) throw new Error('probe_fixture_mismatch');
    const result = await verifier.verify(bytes, fixture);
    return { outcome: result.outcome, pages: result.pages ?? null, sha256: result.sha256 ?? '' };
  },
  fixtureSHA256: fixture.sha256,
  now: Date.now, monotonic: () => performance.now(), sleep: ms => new Promise(resolve => setTimeout(resolve, ms)),
  waitUntil(promise) {
    const runtime = (globalThis as unknown as { EdgeRuntime?: { waitUntil(promise: Promise<void>): void } }).EdgeRuntime;
    if (!runtime || typeof runtime.waitUntil !== 'function') throw new Error('wait_until_unavailable');
    runtime.waitUntil(promise);
  },
  // Observed host property, never the compiled expected string.
  runtimeVersion: Deno.version.deno,
  deploymentID: Deno.env.get('DENO_DEPLOYMENT_ID') ?? null,
  executionID: Deno.env.get('SB_EXECUTION_ID') ?? null,
  isolateID: crypto.randomUUID(),
  log: event => console.log(JSON.stringify(event)),
});
addEventListener('beforeunload', () => handler.beforeUnload());
Deno.serve(handler.fetch);
