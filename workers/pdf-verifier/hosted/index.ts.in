import factory from './verifier.mjs';
import { createVerifier, sha256, type ModuleFactory } from './runtime.ts';
import { createProbeHandler, withProbeStage, type CaseName } from './hosted/handler.ts';
import { config, profile, wasmSHA256, profileSHA256, fixtures, wasmBase64 } from './assets.ts';

const base = `https://${config.project}.supabase.co`;
const anon = Deno.env.get('SUPABASE_ANON_KEY');
if (Deno.env.get('SUPABASE_URL') !== base || !anon) throw new Error('invalid_probe_environment');

const decode = (value: string) => Uint8Array.from(atob(value), character => character.charCodeAt(0));
async function authenticate(token: string, signal: AbortSignal): Promise<unknown> {
  const response = await fetch(base + '/auth/v1/user', {
    method: 'GET', redirect: 'error', signal,
    headers: { apikey: anon!, Authorization: 'Bearer ' + token, Accept: 'application/json' },
  });
  if (!response.ok || response.redirected || !response.body) {
    void response.body?.cancel().catch(() => {});
    throw new Error('probe_auth_failed');
  }
  const reader = response.body.getReader();
  const parts: Uint8Array[] = []; let length = 0;
  try {
    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      length += value.byteLength;
      if (length > 65536) throw new Error('probe_auth_failed');
      parts.push(new Uint8Array(value));
    }
    const bytes = new Uint8Array(length); let offset = 0;
    for (const part of parts) { bytes.set(part, offset); offset += part.length; }
    return JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(bytes));
  } finally { void reader.cancel().catch(() => {}); reader.releaseLock(); }
}

const handler = createProbeHandler(config, {
  authenticate,
  async initialize() {
    const start = performance.now();
    // Generated glue has no TypeScript declaration. The pinned runtime checks
    // its numeric ABI, exported memory size and parser version before parsing.
    const verifier = await withProbeStage('initialization', () => createVerifier({ factory: factory as unknown as ModuleFactory,
      wasm: decode(wasmBase64), wasmSHA256, profile, profileSHA256 }));
    return {
      coldLoadMS: performance.now() - start,
      async verify(name: CaseName) {
        const fixture = fixtures[name];
        const bytes = await withProbeStage('fixture_decode', () => decode(fixture.base64));
        await withProbeStage('fixture_hash', async () => {
          if (bytes.length !== fixture.bytes || await sha256(bytes) !== fixture.sha256) throw new Error('probe_fixture_mismatch');
        });
        const result = await withProbeStage('verification', () => verifier.verify(bytes, fixture));
        await withProbeStage('result_check', () => {
          if (result.outcome !== fixture.expected || (result.pages ?? null) !== fixture.pages || result.sha256 !== fixture.sha256) throw new Error('probe_result_mismatch');
        }, result);
        return result;
      },
    };
  },
  now: Date.now,
  runtime: { ...Deno.version },
  deploymentID: Deno.env.get('DENO_DEPLOYMENT_ID') ?? null,
  executionID: Deno.env.get('SB_EXECUTION_ID') ?? null,
  isolateID: crypto.randomUUID(),
  memory: () => Deno.memoryUsage(),
  log: event => console.log(JSON.stringify(event)),
});
Deno.serve(handler);
