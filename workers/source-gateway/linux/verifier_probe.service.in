[Unit]
Description=Timestep isolated verifier compatibility @ATTEMPT@
Requires=@SLICE@
After=@SLICE@
ConditionPathExists=@ROOT@/control/config.json
ConditionPathExists=!@ROOT@/control/launch-spent.json
ConditionPathExists=!@ROOT@/control/stop-fence.json
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
Slice=@SLICE@
WorkingDirectory=/
ExecStart=/usr/bin/python3 -I -S -B @MODULES@/verifier_probe_bootstrap.py @MODULES@ @CAPTURE@ reaper @ROOT@/control/config.json
Restart=no
RemainAfterExit=no
KillMode=control-group
SendSIGKILL=yes
TimeoutStartSec=5s
TimeoutStopSec=2s
RuntimeMaxSec=20s
UMask=0077
StandardInput=file:@PDF@
StandardOutput=null
StandardError=file:@ROOT@/service.stderr
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SETPCAP
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=@ROOT@/control
InaccessiblePaths=@SPOOLS@
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=~socket connect bind listen accept accept4 io_uring_setup io_uring_enter io_uring_register ptrace process_vm_readv process_vm_writev pidfd_getfd
SystemCallErrorNumber=EPERM
IPAddressDeny=any
TasksMax=64
MemoryMax=256M
MemorySwapMax=0
LimitNOFILE=64
LimitFSIZE=128K

# Finite local compatibility fixture. This unit grants no SQL/host admission.
# Deno's Tokio signal handler requires an anonymous Unix socketpair. External
# socket creation/connection/listening remain denied; no socket is inherited.
