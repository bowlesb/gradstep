[Unit]
Description=Timestep isolated UID/ingress prerequisite @ATTEMPT@
Requires=@SLICE@
After=@SLICE@
ConditionPathExists=@ROOT@/control/input.json
ConditionPathExists=!@ROOT@/observer/stop-fence.json
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# System manager default root; uid_policy verifies all real/effective/saved/fs IDs.
# Explicit User=0 triggers systemd255's seccomp CAP_SETUID drop before exec.
Slice=@SLICE@
WorkingDirectory=@ROOT@
ExecStart=/usr/bin/python3 -I -S -B @BUNDLE@/bootstrap.py @BUNDLE@ linux_launcher @ROOT@
Restart=no
RemainAfterExit=yes
KillMode=control-group
SendSIGKILL=yes
TimeoutStartSec=5s
TimeoutStopSec=2s
RuntimeMaxSec=20s
UMask=0077
StandardInput=null
StandardOutput=null
StandardError=journal
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SETPCAP
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=@ROOT@/data @ROOT@/ingress
InaccessiblePaths=@ROOT@/observer @ROOT@/guardian
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=~socketpair io_uring_setup io_uring_enter io_uring_register ptrace process_vm_readv process_vm_writev pidfd_getfd
SystemCallErrorNumber=EPERM
IPAddressDeny=any
IPAddressAllow=localhost
TasksMax=2
MemoryMax=128M
LimitNOFILE=64

# No Install section; no database, source-network or admission authority.
