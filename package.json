    "google-auth-library": "11.1.0",
    "htmlparser2": "12.0.0",
    "katex": "0.19.0",
    "markdown-it": "9.1.0",
    "mathpix-markdown-it": "3.0.1",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
