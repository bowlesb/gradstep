{
  "name": "science-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:fast",
    "test:fast": "node scripts/test-tiers.mjs fast",
    "test:imports": "node scripts/test-imports.mjs run",
    "test:backend": "node --test tests/backend/*.test.ts",
    "test:slow": "node scripts/test-tiers.mjs slow",
    "test:slow:fetch": "node scripts/fetch-reader-corpus.mjs --on-this-device",
    "test:slow:corpus": "node scripts/test-tiers.mjs corpus",
    "test:slow:native": "node scripts/test-tiers.mjs native",
    "test:status": "node scripts/test-tiers.mjs status",
    "test:ops": "node scripts/test-tiers.mjs ops",
    "test:database": "node scripts/test-tiers.mjs database",
    "dev:admin": "vite apps/admin",
    "build:admin": "tsc --noEmit -p apps/admin/tsconfig.json && vite build apps/admin"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@apple/app-store-server-library": "3.1.0",
    "@noble/hashes": "1.8.0",
    "@supabase/supabase-js": "2.117.2",
    "fflate": "0.8.3",
    "google-auth-library": "11.1.0",
    "htmlparser2": "12.0.0",
    "katex": "0.19.0",
    "markdown-it": "9.1.0",
    "mathpix-markdown-it": "3.0.1",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.0",
    "saxes": "6.0.0",
    "temml": "0.11.11"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "deno": "2.9.6",
    "esbuild": "0.28.2",
    "mermaid": "12.1.0",
    "supabase": "2.119.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "wrangler": "4.148.0"
  },
  "engines": {
    "node": ">=24"
  }
}
