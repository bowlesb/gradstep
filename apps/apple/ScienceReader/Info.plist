  <key>CFBundleURLTypes</key><array><dict><key>CFBundleURLSchemes</key><array><string>sciencereader</string></array></dict></array>
  <key>ScienceReaderSupabaseURL</key><string>$(SCIENCE_READER_SUPABASE_URL)</string>
  <key>ScienceReaderSupabaseAnonKey</key><string>$(SCIENCE_READER_SUPABASE_ANON_KEY)</string>
  <key>ScienceReaderEnvironment</key><string>$(SCIENCE_READER_ENVIRONMENT)</string>
